{"sha": "fcae0d5c6a88077fd8f609d863c7dad151a07ec639da121f15f4463ad5a420b9", "body": ["\\begin{example}[购物]\\label{ex:g5:decimalops:shopping}", "三本笔记本，每本 $2.45$，一支钢笔 $1.20$：", "\\begin{enumerate}", "  \\item 笔记本：$2.45 \\times 3 = 7.35$；", "  \\item 总价：$7.35 + 1.20 = 8.55$；", "  \\item 付 $10$ 时的找零：$10 - 8.55 = 1.45$。", "\\end{enumerate}", "\\end{example}", "", "\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g5:decimalops:1}", "用竖式计算：$45.7 + 8.93$；\\quad $16.25 + 3.75$；\\quad", "$0.86 + 12.4$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g5:decimalops:2}", "用竖式计算并验算：$9.4 - 2.72$；\\quad $20 - 13.45$；", "\\quad $6.03 - 5.9$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g5:decimalops:3}", "口算下列各数凑成 $10$ 所需的补数（见", "\\cref{ex:g5:decimalops:complement}）：$6.2$；\\quad $3.75$；\\quad", "$9.99$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g5:decimalops:4}", "不用竖式，直接计算：", "\\[", "7.24 \\times 10, \\qquad", "0.58 \\times 100, \\qquad", "34.5 \\div 10, \\qquad", "7 \\div 100, \\qquad", "0.3 \\times 1000 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g5:decimalops:5}", "换算下列单位：$4.05$ m 化为 cm；\\quad $325$ cm 化为 m；\\quad $0.6$ kg 化为 g；", "\\quad $85$ cL 化为 L。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g5:decimalops:6}", "先估算，再计算：$6.2 \\times 4$；\\quad", "$3.45 \\times 8$；\\quad $12.5 \\times 6$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g5:decimalops:7}", "跑道一圈长 $0.4$ km。跑 $7$ 圈和", "$25$ 圈各长多少？", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g5:decimalops:8}", "莉亚买了 $2$ 根法棍，每根 $1.15$，又买了一个蛋糕，价格 $12.60$。她", "用一张 $20$ 的纸币付款。计算她的总价和找零。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g5:decimalops:9}", "一瓶装 $1.5$ L。一包 $6$ 瓶共有多少升？", "一家人每天喝 $0.75$ L，一包够喝", "多少天？（$0.75$ 能在 $9$ 里除几次？）", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g5:decimalops:10}", "米洛算出 $5.6 \\times 3 = 15.18$，他的推理是“$5 \\times 3 = 15$", "和 $6 \\times 3 = 18$”。用估算说明答案一定错了，", "再正确计算。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g5:decimalops:11}", "一位跑步者跑四圈，用时分别为 $65.4$ s、$64.9$ s、$65.0$ s 和", "$66.1$ s。", "\\begin{enumerate}", "  \\item 计算四圈的总用时。", "  \\item 四圈的纪录是 $260$ s。她是否打破了纪录？", "        若打破，打破了多少秒？", "\\end{enumerate}", "\\end{exercise}", ""]}