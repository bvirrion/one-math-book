 "result": "1|\\chapter{\u95ee\u9898\u4e0e\u7edf\u8ba1\u56fe}\\label{ch:g5:data}\n2|=\n3|\u672c\u7ae0\u662f\u5168\u5e74\u6700\u540e\u4e00\u7ae0\uff0c\u7efc\u5408\u8fd0\u7528\u6240\u5b66\u77e5\u8bc6\uff1a\u591a\u6b65\u95ee\u9898\n4|\u6d89\u53ca\u94b1\u6570\u3001\u6570\u91cf\u548c\u65f6\u957f\uff0c\u4ee5\u53ca\u80fd\u4e00\u773c\u770b\u6e05\u4fe1\u606f\u7684\u7edf\u8ba1\u56fe\u3002\n5|\u6838\u5fc3\u601d\u60f3\u662f\u201c\u6c42\u4e00\u201d\u2014\u2014\n6|\u5373\u6c42\u51fa\u5355\u4e2a\u7269\u54c1\u7684\u4ef7\u683c\u3002\u8fd9\u4e00\u601d\u60f3\u5c06\n7|\u5728\\cref{ch:g6:propdata}\u4e2d\u53d1\u5c55\u4e3a\u6bd4\u4f8b\u3002\n8|=\n9|\\section{\u591a\u6b65\u95ee\u9898}\n10|=\n11|\\begin{method}[\u89e3\u51b3\u957f\u9898\u76ee]\\label{met:g5:data:steps}\n12|=\n13|  \\item \u8bfb\u5b8c\u5168\u9898\uff0c\u8bf4\u51fa\u6700\u540e\u8981\u6c42\u7684\u95ee\u9898\uff1b\n14|  \\item \u9006\u5411\u601d\u8003\uff1a\u8981\u56de\u7b54\u5b83\uff0c\u5148\u9700\u8981\u77e5\u9053\u4ec0\u4e48\uff1f\n15|  \\item \u6309\u987a\u5e8f\u9010\u6b65\u6c42\u89e3\uff0c\u6bcf\u4e00\u6b65\u5199\u51fa\u4e00\u4e2a\u8fd0\u7b97\u548c\n16|        \u4e00\u53e5\u7b80\u77ed\u7684\u8bdd\uff1b\n17|  \\item \u5c06\u6700\u7ec8\u7b54\u6848\u4e0e\u5e38\u8bc6\u548c\u4f30\u7b97\u7ed3\u679c\u5bf9\u7167\uff0c\n18|        \u68c0\u67e5\u5176\u662f\u5426\u5408\u7406\u3002\n19|=\n20|=\n21|=\n22|\\begin{example}\\label{ex:g5:data:multistep}\n23|\u201c\u67d0\u6821\u8ba2\u8d2d $4$ \u7bb1\u4e66\uff0c\u6bcf\u7bb1 $25$ \u672c\uff0c\u6bcf\u672c $6$ \u5143\uff0c\n24|\u53e6\u52a0\u8fd0\u8d39 $180$ \u5143\u3002\u603b\u8d39\u7528\u662f\u591a\u5c11\uff1f\u201d\n25|=\n26|  \\item \u4e66\u7684\u6570\u91cf\uff1a$4 \\times 25 = 100$ \u672c\u3002\n27|  \\item \u4e66\u7684\u8d39\u7528\uff1a$100 \\times 6 = 600$ \u5143\u3002\n28|  \\item \u603b\u8d39\u7528\uff1a$600 + 180 = 780$ \u5143\u3002\n29|=\n30|\u4f30\u7b97\u68c0\u9a8c\uff1a\u7ea6\u4e00\u767e\u672c\u4e66\uff0c\u6bcf\u672c $6$ \u5143\uff0c\u7ea6 $600$ \u5143\uff0c\n31|\u518d\u52a0\u7ea6 $200$ \u5143\uff0c\u7ea6 $800$ \u5143\u2014\u2014\u7b54\u6848 $780$ \u5143\u662f\u5408\u7406\u7684\u3002\n32|=\n33|=\n34|\\begin{example}[\u6c42\u4e00]\\label{ex:g5:data:perone}\n35|\u201c$5$ \u4e2a\u76f8\u540c\u7684\u676f\u5b50\u5171 $12.50$ \u5143\uff0c$8$ \u4e2a\u676f\u5b50\u8981\u591a\u5c11\u94b1\uff1f\u201d\n36|\u5148\u6c42\u51fa\\emph{\u4e00}\u4e2a\u676f\u5b50\u7684\u4ef7\u683c\uff1a\n37|=\n38|=\n39|\\qquad\\text{\u7136\u540e}\\qquad\n40|=\n41|=\n42|\u7531\u201c\u4e00\u201d\u51fa\u53d1\uff0c\u4e00\u5207\u90fd\u53ef\u6c42\u5f97\u2014\u2014\u8fd9\u79cd\u4e24\u6b65\u65b9\u6cd5\n43|\u53ef\u89e3\u51b3\u4e00\u7c7b\u95ee\u9898\uff08\u914d\u65b9\u3001\u901f\u5ea6\u3001\u4ef7\u683c\uff09\uff0c\u5b83\u4e5f\u662f\n44|\u4e5f\u662f\\cref{ch:g6:propdata}\u7684\u8d77\u70b9\u3002\n45|=\n46|=\n47|\\begin{example}[\u627e\u96f6\u4e0e\u9884\u7b97]\\label{ex:g5:data:budget}\n48|\u4f50\u4f0a\u6709 $30$ \u5143\u3002\u5979\u4e70\u4e86\u4e00\u672c\u4e66\uff0c\u4ef7 $12.40$ \u5143\uff0c\u53c8\u4e70\u4e86\u4e24\u652f\u7b14\uff0c\n49|\u6bcf\u652f $2.30$ \u5143\u3002\u5979\u8fd8\u80fd\u4e70\u5f97\u8d77\u4e00\u4e2a $13$ \u5143\u7684\u68cb\u76d8\u6e38\u620f\u5417\uff1f\n50|=\n51|  \\item \u7b14\u7684\u8d39\u7528\uff1a$2 \\times 2.30 = 4.60$ \u5143\u3002\n52|  \\item \u5df2\u82b1\u8d39\uff1a$12.40 + 4.60 = 17$ \u5143\u3002\n53|  \\item \u5269\u4f59\uff1a$30 - 17 = 13$ \u5143\u2014\u2014\u6b63\u597d\u591f\u4e70\u68cb\u76d8\u6e38\u620f\uff0c\n54|        \u4e14\u6ca1\u6709\u5269\u4f59\u3002\n55|=\n56|=\n57|=\n58|\\section{\u8bfb\u7edf\u8ba1\u56fe}\n59|=\n60|\\begin{method}[\u8bfb\u4efb\u4f55\u7edf\u8ba1\u56fe]\\label{met:g5:data:read}\n61|=\n62|  \\item \u8bfb\u6807\u9898\uff1a\u7edf\u8ba1\u7684\u662f\u4ec0\u4e48\uff1f\n63|  \\item \u770b\u5750\u6807\u8f74\u6216\u56fe\u4f8b\uff1a\u4e00\u683c\u523b\u5ea6\u3001\u4e00\u4e2a\u67f1\u5b50\u3001\n64|        \u4e00\u4e2a\u7b26\u53f7\u5206\u522b\u4ee3\u8868\u4ec0\u4e48\uff1f\n65|  \\item \u7136\u540e\u518d\u56de\u7b54\u95ee\u9898\u2014\u2014\u7528\u76f4\u