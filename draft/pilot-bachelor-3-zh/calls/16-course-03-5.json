 "result": "256|\\section{\u89e3\u6790\u6027\u53ca\u5176\u8fde\u9501\u63a8\u8bba}\n257|=\n258|\\begin{theorem}[\u5168\u7eaf $=$ \u89e3\u6790]\n259|=\n260|\u8bbe $f \\in \\mathcal H(\\Omega)$\uff0c\u4e14 $D(a, R) \\subseteq \\Omega$\u3002\n261|\u5219\\index{\u5168\u7eaf\u51fd\u6570\u7684\u89e3\u6790\u6027}\n262|=\n263|f(z) = \\sum_{n\\geq0}c_n\\,(z - a)^n \\quad \\text{\u5728 } D(a, R) \\text{ \u4e0a},\n264|=\n265|=\n266|=\n267|=\n268|\u7cfb\u6570\u5747\u4e0e $r$ \u65e0\u5173\u3002\u56e0\u6b64 $f$ \u662f\n269|\u65e0\u7a77\u6b21 $\\C$-\u53ef\u5fae\u7684\uff0c$c_n = f^{(n)}(a)/n!$\uff0c\u5e76\u4e14\n270|\\emph{\u67ef\u897f\u4f30\u8ba1}\\index{\u67ef\u897f\u4f30\u8ba1}\u6210\u7acb\uff1a\n271|=\n272|=\n273|=\n274|=\n275|=\n276|=\n277|=\n278|\u5f53 $\\abs{z - a} < r$ \u65f6\uff0c\u5c06\u67ef\u897f\u6838\u6309\n279|\u51e0\u4f55\u7ea7\u6570\u5c55\u5f00\n280|=\n281|=\n282|=\n283|=\n284|\u5173\u4e8e $w$ \u5728 $C_r$ \u4e0a\u6b63\u89c4\u6536\u655b\uff08$\\abs{\\frac{z-a}{w-a}} =\n285|\\frac{\\abs{z-a}}r < 1$\uff09\uff1a\u5c06\u7ea7\u6570\u9010\u9879\u4e0e\n286|$\\frac{f(w)}{2\\iu\\pi}$ \u76f8\u4e58\u540e\u79ef\u5206\uff08\u4e00\u81f4\u6536\u655b\n287|\u4f7f\u6c42\u548c\u4e0e\u79ef\u5206\u53ef\u4ea4\u6362\uff09\uff0c\u5e76\u5e94\u7528\\cref{thm:b3:holomorphic:formula}\u3002\n288|\u5e42\u7ea7\u6570\u65e0\u7a77\u6b21\u53ef\u5fae\uff0c\u4e14 $c_n =\n289|f^{(n)}(a)/n!$\uff08\u672c\u79d1\u4e8c\u5e74\u7ea7\uff09\uff0c\u8fd9\u4e5f\u8bf4\u660e $c_n$\n290|\u4e0d\u4f9d\u8d56\u4e8e $r$\u3002\u81f3\u4e8e\u4f30\u8ba1\u5f0f\uff0c\n291|\u7528 ML \u4e0d\u7b49\u5f0f\u4f30\u8ba1\u7cfb\u6570\u79ef\u5206\u3002\n292|=\n293|=\n294|\\begin{example}[\u5947\u70b9\u51b3\u5b9a\u6536\u655b\u534a\u5f84]\n295|=\n296|\u4e3a\u4ec0\u4e48\u770b\u4f3c\u65e0\u5bb3\u7684\u5b9e\u51fd\u6570 $\\frac1{1 + x^2}$ \u5728\n297|$x = 3$ \u5904\u7684\u6cf0\u52d2\u7ea7\u6570\u53ea\u5728 $\\abs{x - 3} <\n298|\\sqrt{10}$ \u65f6\u6536\u655b\uff0c\u800c\u5b9e\u8f74\u4e0a\u770b\u4e0d\u51fa\u4efb\u4f55\u5f02\u5e38\uff1f\u539f\u56e0\u5728\u4e8e\n299|\u7531\u4e0a\u8ff0\u5b9a\u7406\u53ef\u77e5\uff0c$a$ \u5904\u7684\u6536\u655b\u534a\u5f84\n300|\u6070\u7b49\u4e8e $a$ \u5230\u5168\u7eaf\u6027\u5931\u6548\u7684\u6700\u8fd1\u70b9\u7684\u8ddd\u79bb\u3002\n301|\u8fd9\u91cc $f(z) = \\frac1{1 + z^2}$ \u5728\n302|$\\C\\setminus\\{\\pm\\iu\\}$ \u4e0a\u6070\u597d\u5168\u7eaf\uff0c\u56e0\u6b64\n303|$a = 3$ \u5904\u7684\u5c55\u5f00\u5f0f\u5728\u907f\u5f00\n304|$\\pm\\iu$ \u7684\u6700\u5927\u5706\u76d8\u4e0a\u6536\u655b\uff0c\u5176\u534a\u5f84\u4e3a $\\abs{3 - \\iu} = \\sqrt{10}$ --- \u4e14\n305|\u4e0d\u80fd\u5728\u66f4\u5927\u7684\u5706\u76d8\u4e0a\u6536\u655b\uff0c\u56e0\u4e3a\u548c\u51fd\u6570\u4f1a\u5c06\n306|$f$ \u5168\u7eaf\u5ef6\u62d3\u5230 $\\pm\\iu$ \u7684\u67d0\u4e2a\u90bb\u57df\u4e0a\uff0c\u800c\u5728\u90a3\u91cc\n307|$\\abs f \\to \\infty$\u3002\u5b9e\u6570\u7406\u8bba\u770b\u5230\u7684\u662f\u795e\u79d8\u7684\n308|\u6536\u655b\u534a\u5f84 $\\sqrt{10}$\uff1b\u590d\u5e73\u9762\u770b\u5230\u7684\u5219\u662f\u4e24\u4e2a\u6781\u70b9\u3002\n309|\u8fd9\u5c31\u662f\u5b9e\u7528\u89c4\u5219\uff1a\\emph{\u6c42\u6536\u655b\u534a\u5f84\uff0c\u53ea\u9700\n310|\u5b9a\u4f4d\u5947\u70b9} --- \u4f8b\u5982\n311|$\\tan$ \u5728 $0$ \u5904\u7684\u6cf0\u52d2\u7ea7\u6570\u7684\u6536\u655b\u534a\u5f84\u4e3a $\\frac\\pi2$\uff08\u8ddd\u79bb\u6700\u8fd1\u7684\n312|$\\cos$ \u7684\u96f6\u70b9\uff09\uff0c\u800c\u4f2f\u52aa\u5229\u6570\u7684\u6bcd\u51fd\u6570\n313|$\\frac z{\\eu^z - 1}$\uff08\\cref{pb:b3:holomorphic:1}\uff0c\u7b2c VI \u90e8\u5206\uff09\n314|\u5176\u6536\u655b\u534a\u5f84\u4e3a $2\\pi$\uff08$\\eu^z - 1$ \u7684\u6700\u8fd1\u975e\u96f6\u96f6\u70b9\uff1a\n315|$\\pm2\\iu\\pi$\uff09\u3002\n316|=\n317|=\n318|\\begin{corollary}[\u5218\u7ef4\u5c14\uff1b\u8fbe\u6717\u8d1d\u5c14--\u9ad8\u65af]\n319|=\n320|\u6709\u754c\u6574\u51fd\u6570\u5fc5\u4e3a\u5e38\u503c\u3002\u7531\u6b64\u53ef\u77e5\uff0c\n321|\u5728 $\\C$ \u4e0a\u6bcf\u4e2a\u975e\u5e38\u503c\u591a\u9879\u5f0f\u90fd\u6709\u6839\uff0c\u5373 \\emph{$\\C$ \u662f\n322|\u4ee3\u6570\u95ed}\u3002\\index{\u5218\u7ef4\u5c14\u5b9a\u7406}\\index{\u4ee3\u6570\u57fa\u672c\n323|\u5b9a\u7406}\n324|=\n325|=\n326|=\n327|\u82e5 $\\abs f \\leq M$ \u5728 $\\C$ \u4e0a\uff0c\u5219\u5bf9\u6bcf\u4e2a $a$ \u4e0e $r$\uff0c\u6709 $\\abs{c_1(a)}\n328|= \\abs{f'(a)} \\leq M/r \\to 0$\uff0c\u4e8e\u662f $f' \\equiv 0$\uff0c\u4e14 $f$ \u4e3a\n329|\u5e38\u503c\uff08\u5728\u8fde\u901a\u7684 $\\C$ \u4e0a\uff0c\u5bfc\u6570\u6052\u4e3a\u96f6\u8574\u542b\n330|\u5c40\u90e8\u5e38\u503c --- \u6cbf\u7ebf\u6bb5\u79ef\u5206\u5373\u53ef\uff09\u3002\u82e5 $P$ \u6ca1\u6709\n331|\u6839\uff0c\u5219 $1/P$ \u4e3a\u6574\u51fd\u6570\u4e14\u6709\u754c\uff08$\\abs{P(z)} \\to\n332|\\infty$\uff0c\u5373 $\\abs z \\to \\infty$ \u65f6\u9996\u9879\u5360\u4e3b\u5bfc\uff0c\u56e0\u6b64\n333|$\\abs{1/P}$ \u5728\u5927\u5706\u76d8\u5916\u5f88\u5c0f\uff0c\u4e14\u5728\n334|\u7d27\u5706\u76d8\u4e0a\u8fde\u7eed\uff09\uff1a\u5fc5\u4e3a\u5e38\u503c\uff0c\u8fd9\u5bf9\u975e\u5e38\u503c\u7684 $P$ \u662f\u8352\u8c2c\u7684\u3002\n335|\uff08\u5468\u672b\u95ee\u9898\u7ed9\u51fa\u4e86\u7b2c\u4e8c\u4e2a\u521d\u7b49\u8bc1\u660e\u4ee5\u53ca\n336|\u5176\u4ee3\u6570\u63a8\u8bba\u3002\uff09\n337|=\n338|=\n339|\\begin{theorem}[\u96f6\u70b9\u5b64\u7acb\uff1b\u6052\u7b49\u5b9a\u7406]\n340|=\n341|\u8bbe $\\Omega$ \u4e3a\\emph{\u8fde\u901a}\u7684\uff0c\u4e14 $f \\in \\mathcal\n342|H(\\Omega)$\uff0c$f \\not\\equiv 0$\u3002\u5219\u6bcf\u4e2a\u96f6\u70b9 $a$\uff08\u5373 $f$ \u7684\u96f6\u70b9\uff09\u90fd\u5177\u6709\n343|\u6709\u9650\\emph{\u9636}\uff1a$f(z) = (z - a)^m\\,g(z)$\uff0c\u5176\u4e2d $g \\in\n344|\\mathcal H(\\Omega)$\uff0c$g(a) \\neq 0$\uff0c\u4e14 $f$ \u7684\u96f6\u70b9\n345|\u5728 $\\Omega$ \u4e2d\u65e0\u805a\u70b9\u3002\u7531\u6b64\u53ef\u5f97\uff1a\n346|$\\Omega$ \u4e0a\u7684\u4e24\u4e2a\u5168\u7eaf\u51fd\u6570\u82e5\u5728\n347|$\\Omega$ \u4e2d\u6709\u805a\u70b9\u7684\u96c6\u5408\u4e0a\u53d6\u503c\u76f8\u540c\uff0c\n348|\u5219\u4e8c\u8005\u5904\u5904\u76f8\u7b49\u3002\\index{\u6052\u7b49\u5b9a\u7406}\\index{\u5b64\u7acb\u96f6\u70b9}\n349|=\n350|=\n351|=\n352|\u8bbe $Z$ \u4e3a\u4f7f $f$ \u7684\u6240\u6709\u5bfc\u6570\n353|\u90fd\u4e3a\u96f6\u7684\u70b9\u6784\u6210\u7684\u96c6\u5408\u3002$Z$ \u662f\u95ed\u96c6\uff08\u95ed\u96c6\u4e4b\u4ea4\uff09\uff0c\u4e14\u662f\u5f00\u96c6\uff1a\n354|\u82e5\u6240\u6709 $c_n = 0$\uff08\u5728 $a$ \u5904\uff09\uff0c\u5219\u5e42\u7ea7\u6570\u5c55\u5f00\u4f7f $f\n355|\\equiv 0$ \u5728 $a$ \u7684\u67d0\u5706\u76d8\u4e0a\u3002\u7531\u8fde\u901a\u6027\uff0c$Z =\n356|\\varnothing$ \u6216 $Z = \\Omega$\uff1b\u540e\u8005\u4e0e $f\n357|\\not\\equiv 0$ \u77db\u76fe\u3002\u6545\u5728\u96f6\u70b9 $a$ \u5904\uff0c\u67d0\u4e2a\u7cfb\u6570\u975e\u96f6\uff1a\n358|\u53d6 $m$ \u4e3a\u4f7f $c_m \\neq 0$ \u7684\u6700\u5c0f\u6307\u6807\uff0c\u5219 $f(z) = (z -\n359|a)^m\\sum_{n\\geq m}c_n(z-a)^{n-m}$ \u5728\u67d0\u5706\u76d8\u4e0a\u6210\u7acb\uff0c\u4e14\u8be5\u548c\n360|\u5f0f\u5b9a\u4e49\u4e86 $g$\uff0c\u5b83\u5728 $a$ \u9644\u8fd1\u5168\u7eaf\uff0c\u4e14 $g(a) = c_m \\neq 0$\uff1b\n361|\u5e76\u4ee4 $g = f/(z-a)^m$\uff08\u5728 $a$ \u4e4b\u5916\u5168\u7eaf\uff09\u3002\u7531\u4e8e\n362|$g(a) \\neq 0$ \u4e14 $g$ \u8fde\u7eed\uff0c\u6545 $f$ \u5728\n363|$a$ \u7684\u90bb\u57df\u5185\u6ca1\u6709\u5176\u4ed6\u96f6\u70b9\uff1a\u96f6\u70b9\u662f\u5b64\u7acb\u7684\uff0c\u4e14\u5b64\u7acb\u70b9\u7684\u96c6\u5408\n364|\u5728 $\\Omega$ \u4e2d\u65e0\u805a\u70b9\uff08\n365|\u96f6\u70b9\u7684\u805a\u70b9\u4ecd\u662f\u96f6\u70b9 --- \u7531\u8fde\u7eed\u6027 --- \u4e14\n366|\u4e0d\u4f1a\u662f\u5b64\u7acb\u7684\uff09\u3002\u6052\u7b49\u5b9a\u7406\uff1a\u5bf9\u4e24\u8005\u4e4b\u5dee\u5e94\u7528\u4e0a\u8ff0\u7ed3\u8bba\uff0c\n367|\u5176\u96f6\u70b9\u96c6\u6709\u805a\u70b9\uff0c\u4ece\u800c\u8feb\u4f7f\u5b83\u843d\u5165\n368|$Z = \\Omega$ \u5206\u652f\u3002\n369|=\n370|=",
