hm:b2:metric:compactprops}\n265|=\n266|  \\item \u7d27\u5b50\u96c6\u662f\u95ed\u96c6\u4e14\u6709\u754c\uff1b\u7d27\u7a7a\u95f4\u7684\u95ed\u5b50\u96c6\n267|        \u662f\u7d27\u7684\u3002\n268|  \\item \u5728 $\\R^n$ \u4e2d\u9006\u547d\u9898\u4e5f\u6210\u7acb\uff1a\u7d27 $\\iff$ \u95ed\u4e14\n269|        \u6709\u754c\u3002\n270|  \\item \u7d27\u7a7a\u95f4\u7684\u8fde\u7eed\u50cf\u662f\u7d27\u7684\uff1b\n271|        \u975e\u7a7a\u7d27\u7a7a\u95f4\u4e0a\u7684\u8fde\u7eed\u5b9e\u51fd\u6570\n272|        \u6709\u754c\uff0c\u4e14\u53ef\u53d6\u5230\u5176\u4e0a\u3001\u4e0b\u786e\u754c\u3002\n273|  \\item \uff08\u6d77\u6d85\uff09\u7d27\u7a7a\u95f4\u4e0a\u7684\u8fde\u7eed\u6620\u5c04\u4e00\u81f4\n274|        \u8fde\u7eed\u3002\n275|  \\item \u4e58\u79ef\uff1a\u82e5 $X, Y$ \u7d27\uff0c\u5219 $X \\times Y$ \u4ea6\u7d27\uff08\u5ea6\u91cf\u53d6\u4e3a\n276|        $d\\bigl((x,y),(x',y')\\bigr) = d(x,x') + d(y,y')$\uff09\u3002\n277|=\n278|=\n279|=\n280|=\n281|\uff081\uff09\u4e0e\u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u4e2d\u7684\u8bba\u8bc1\u76f8\u540c\uff1a\u4e00\u4e2a\u8d8b\u4e8e%\n282| \u65e0\u7a77\u8fdc\u6216\u6536\u655b\u4e8e\u5916\u90e8\u7684\u6570\u5217\uff0c\u90fd\u6ca1\u6709\n283| \u5728\u5185\u90e8\u6536\u655b\u7684\u5b50\u5217\uff1b\u7b2c\u4e8c\u4e2a\u65ad\u8a00\u5219\u5728\n284| \u6240\u5728\u7684\u7d27\u7a7a\u95f4\u4e2d\u62bd\u53d6\u5b50\u5217\uff0c\u5e76\u5229\u7528\u95ed\u6027\u3002\n285|=\n286|\uff082\uff09$\\R^n$ \u4e2d\u7684\u6709\u754c\u6570\u5217\u6709\u9010\u5206\u91cf\u6536\u655b\u7684\n287| \u5b50\u5217\uff1a\u5148\u5728\u7b2c\u4e00\u4e2a\u5750\u6807\u4e0a\u62bd\u53d6\u5b50\u5217\uff0c\n288| \uff08\u5bf9 $\\R$ \u7528\u5e03\u5c14\u67e5\u8bfa\u2013\u9b4f\u5c14\u65af\u7279\u62c9\u65af\u5b9a\u7406\uff09\uff0c\u518d\u4ece\u8be5\u5b50\u5217\u51fa\u53d1\u5728\n289| \u7b2c\u4e8c\u4e2a\u5750\u6807\u4e0a\u62bd\u53d6\uff0c\u4f9d\u6b64\u7c7b\u63a8\uff08\u5171 $n$ \u6b21\u8fde\u7eed\u62bd\u53d6\uff09\uff1b\u95ed\u6027\u4fdd\u8bc1\n290| \u6781\u9650\u4ecd\u843d\u5728\u