 "result": "1|\\chapter{\u53ef\u6570\u7a7a\u95f4\u4e0a\u7684\u6982\u7387}\\label{ch:b2:proba}\n2|=\n3|\u6700\u540e\u4e09\u7ae0\u53d1\u5c55\u73b0\u4ee3\u6982\u7387\u8bba\uff1a\n4|\u53ef\u6570\u6837\u672c\u7a7a\u95f4\u4e0a\u7684\u6982\u7387\u6d4b\u5ea6\u3001\n5|\u79bb\u6563\u968f\u673a\u53d8\u91cf\u4e0e\u6bcd\u51fd\u6570\u3002\n6|\u9ad8\u4e2d\u5206\u518c\u4e2d\u7684\u6709\u9650\u7406\u8bba\u83b7\u5f97\u4e86\u5b8c\u6574\u7684\n7|\u57fa\u7840\u6846\u67b6\uff1a$\\sigma$-\u53ef\u52a0\u6027\u53d6\u4ee3\u6709\u9650\u53ef\u52a0\u6027\uff0c\n8|\u800c\\cref{ch:b2:series}\u4e2d\u7684\u53ef\u548c\u65cf\u7406\u8bba\u6070\u597d\u662f\n9|\u4f7f\u65e0\u9650\u6837\u672c\u7a7a\u95f4\u53ef\u4ee5\u5904\u7406\u7684\u5173\u952e\u3002\n10|\u672c\u7ae0\u7684\u6838\u5fc3\u7ed3\u679c\u662f\u6982\u7387\u6cbf\u5355\u8c03\u4e8b\u4ef6\u5217\u7684\n11|\u8fde\u7eed\u6027\u4e0e\u535a\u96f7\u5c14--\u574e\u7279\u5229\u5f15\u7406\u3002\n12|=\n13|\\section{\u6982\u7387\u7a7a\u95f4}\n14|=\n15|\\begin{definition}[\u53ef\u6570\u6982\u7387\u7a7a\u95f4]\\label{def:b2:proba:space}\n16|\u8bbe $\\Omega$ \u4e3a\u975e\u7a7a\u6709\u9650\u6216\u53ef\u6570\u96c6\u5408\uff08\n17|\\emph{\u6837\u672c\u7a7a\u95f4}\\index{\u6837\u672c\u7a7a\u95f4}\uff09\u3002\n18|$\\Omega$ \u4e0a\u7684\\emph{\u6982\u7387\u6d4b\u5ea6}\\index{\u6982\u7387\u6d4b\u5ea6}\u662f\n19|\u6620\u5c04 $\\P$ \u628a\u96c6\u5408 $\\mathcal{P}(\\Omega)$\n20|\uff08\u5373 $\\Omega$ \u7684\u5168\u4f53\u5b50\u96c6\uff0c\u79f0\u4e3a\\emph{\u4e8b\u4ef6}\\index{\u4e8b\u4ef6}\uff09\u6620\u5230 $[0, 1]$\uff0c\u4f7f\u5f97\uff1a\n21|\\begin{enumerate}\n22|=\n23|\\item \uff08$\\sigma$-\u53ef\u52a0\u6027\uff09\u5bf9\u6bcf\u4e2a\n24|\u4e24\u4e24\u4e0d\u4ea4\u4e8b\u4ef6\u7ec4\u6210\u7684\u5e8f\u5217 $(A_n)_{n\\in\\N}$\uff0c\n25|=\n26|=\n27|=\n28|=\n29|=\n30|\u79f0\u4e8c\u5143\u7ec4 $(\\Omega, \\P)$ \u4e3a\uff08\u53ef\u6570\uff09\n31|\\emph{\u6982\u7387\u7a7a\u95f4}\\index{\u6982\u7387\u7a7a\u95f4}\u3002\n32|\\end{definition}\n33|=\n34|=\n35|\u5728\u53ef\u6570\u96c6 $\\Omega$ \u4e0a\u53ef\u628a\u5168\u90e8\u5b50\u96c6\u90fd\u53d6\u4f5c\u4e8b\u4ef6\uff1b\u5728\n36|\u4e0d\u53ef\u6570\u7a7a\u95f4\u4e0a\uff08\u672c\u79d1\u4e09\u5e74\u7ea7\u8ba8\u8bba\u8fde\u7eed\u6a21\u578b\u65f6\u9700\u8981\uff09\uff0c\n37|\u8fd9\u4e00\u505a\u6cd5\u4fbf\u4e0d\u518d\u53ef\u884c\uff0c\u6b64\u65f6\u9700\u5c06 $\\P$ \u9650\u5236\u4e8e\u9002\u5f53\u7684\n38|\u4e8b\u4ef6\u65cf\u4e0a\uff0c\u8be5\u4e8b\u4ef6\u65cf\u79f0\u4e3a\\emph{$\\sigma$-\u4ee3\u6570}\u3002\u672c\u7ae0\u7684\u5168\u90e8\u516c\u5f0f\n39|\u5728\u8be5\u63a8\u5e7f\u4e0b\u539f\u6837\u6210\u7acb\u3002\n40|\\end{remark}\n41|=\n42|\\begin{proposition}[\u57fa\u672c\u6027\u8d28]\\label{prop:b2:proba:rules}\n43|\u5bf9\u4e8b\u4ef6 $A, B$ \u53ca\u6982\u7387\u6d4b\u5ea6 $\\P$\uff0c\u6709\uff1a\n44|$\\P(\\emptyset) = 0$\uff1b$\\P$ \u6709\u9650\u53ef\u52a0\uff1b$\\P(A^c) = 1 -\n45|\\P(A)$\uff1b\u82e5 $A \\subseteq B$\uff0c\u5219 $\\P(A) \\leq \\P(B)$\uff1b\u4e14\n46|=\n47|=\n48|=\n49|\\end{proposition}\n50|=\n51|\\begin{proof}\n52|\u8fd0\u7528 $\\sigma$-\u53ef\u52a0\u6027\uff0c\u53d6 $A_0 = \\Omega$\uff0c$A_n = \\emptyset$\n53|\uff08$n \\geq 1$\uff09\u5f97 $1 = 1 + \\sum_{n\\geq1}\\P(\\emptyset)$\uff0c\u6545\n54|$\\P(\\emptyset) = 0$\u3002\u5bf9\u6709\u9650\u4e2a\u4e0d\u4ea4\u5e76\uff0c\u8865\u4e0a\u7a7a\u96c6\u5373\u5f97\n55|\u6709\u9650\u53ef\u52a0\u6027\u3002\u5176\u4f59\u8bba\u8bc1\u4e0e\u6709\u9650\u60c5\u5f62\uff08\n56|\u9ad8\u4e2d\u5206\u518c\uff09\u4e00\u81f4\uff1a$1 = \\P(A) + \\P(A^c)$\uff0c\n57|\u7531 $\\Omega = A \\sqcup A^c$ \u53ef\u5f97\uff1b$\\P(B) = \\P(A) + \\P(B \\setminus A)\n58|\\geq \\P(A)$\uff08\u5f53 $A \\subseteq B$ \u65f6\uff09\uff1b\u5e76\u5c06\n59|\u5176\u5206\u6210\u4e09\u4e2a\u4e0d\u4ea4\u7684\u90e8\u5206\uff0c\n60|=\n61|=\n62|=\n63|=\n64|=\n65|=\n66|\u5373\u5bb9\u65a5\u539f\u7406\uff1b\u4e00\u822c\u7684 $n$ \u4e2a\u96c6\u5408\u7248\u672c\n67|\u89c1\\cref{exo:b2:proba:4}\u3002\n68|\\end{proof}\n69|=\n70|\\begin{proposition}[\u53ef\u6570\u7a7a\u95f4\u4e0a\u7684\n71|\u5206\u5e03]\\label{prop:b2:proba:distribution}\n72|\u5728\u53ef\u6570\u96c6 $\\Omega =\n73|\\{\\omega_0, \\omega_1, \\dots\\}$ \u4e0a\u7ed9\u51fa\u6982\u7387\u6d4b\u5ea6\uff0c\u7b49\u4ef7\u4e8e\u7ed9\u51fa\n74|\u975e\u8d1f\u6743\u91cd $p_i = \\P(\\{\\omega_i\\}) \\geq 0$\uff0c\u6ee1\u8db3 $\\sum_i p_i = 1$\uff1b\u4e8e\u662f\u5bf9\n75|\u6bcf\u4e2a $A \\subseteq \\Omega$\uff0c\n76|=\n77|=\n78|=\n79|\u8fd9\u662f\u65cf $(p_i)$ \u7684\u4e00\u4e2a\uff08\u7edd\u5bf9\u6536\u655b\u7684\uff09\u5b50\u548c\u3002\n80|\\end{proposition}\n81|=\n82|\\begin{proof}\n83|\u7ed9\u5b9a $\\P$\uff0c\u5355\u70b9\u96c6 $\\{\\omega\\}$\uff08$\\omega \\in A$\uff09\u6784\u6210\n84|$A$ \u7684\u4e00\u4e2a\u53ef\u6570\u4e0d\u4ea4\u8986\u76d6\uff0c\u6545\u7531 $\\sigma$-\u53ef\u52a0\u6027\u5fc5\u6709\n85|=\n86|=\n87|=\n88|\u8fd9\u662f\u975e\u8d1f\u53ef\u548c\u65cf\u7684\u4e00\u4e2a\u65e0\u6761\u4ef6\u5b50\u548c\n89|$(p_i)$ --- \u91cd\u6392\u65e0\u5bb3\uff0c\u6070\u56e0\u4e3a\n90|\u5404\u9879\u975e\u8d1f\uff08\u89c1\\cref{ch:b2:series}\uff09\u3002\u7279\u522b\u5730\uff0c\n91|$\\sum_ip_i = \\P(\\Omega) = 1$\u3002\n92|\u53cd\u4e4b\uff0c\u7ed9\u5b9a\u603b\u548c\u4e3a $1$ \u7684\u975e\u8d1f\u6743\u91cd\uff0c\u5b9a\u4e49\n93|$\\P(A) = \\sum_{\\omega \\in A}p_\\omega$\uff1a\u8be5\u65cf\u53ef\u548c\uff0c\u4e14\n94|$\\sigma$-\u53ef\u52a0\u6027\u6070\u662f\n95|\u5728\\cref{ch:b2:series}\u4e2d\u7684\u5206\u7ec4\u6c42\u548c\u5b9a\u7406\uff0c\u5e94\u7528\u4e8e $\\bigcup A_n$ \u7684\n96|\u5404 $A_n$ \u6240\u6210\u7684\u5212\u5206\u3002\n97|\\end{proof}\n98|=\n99|\\begin{example}[\u51e0\u4f55\u6a21\u578b\uff1a\u7b49\u5f85\u9996\u6b21\n100|\u6b63\u9762\u51fa\u73b0]\\label{ex:b2:proba:geometric}\n101|\u53cd\u590d\u6295\u63b7\u6b63\u9762\u6982\u7387\u4e3a $p \\in \\intoo{0}{1}$ \u7684\u786c\u5e01\uff0c\n102|\u5e76\u4ee4 $\\Omega = \\N^* \\cup \\{\\infty\\}$\uff0c\u8bb0\u5f55\u9996\u6b21\n103|\u51fa\u73b0\u6b63\u9762\u7684\u5e8f\u53f7\u3002\u81ea\u7136\u7684\u6743\u91cd\u4e3a\n104|=\n105|=\n106|=\n107|=\n108|=\n109|=\n110|\u