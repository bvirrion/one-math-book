 "result": "1|\\chapter{\u6570\u5217\u4e0e\u7ea7\u6570}\\label{ch:b2:series}\n2|=\n3|\u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u4e2d\u7684\u6570\u503c\u7ea7\u6570\u7406\u8bba\u5728\u6b64\u6cbf\u4e09\u4e2a\u65b9\u5411\u6df1\u5316\uff1a\n4|\u5176\u4e00\u662f\u53d6\u503c\u4e8e\u5df4\u62ff\u8d6b\u7a7a\u95f4\u7684\u7ea7\u6570\uff0c\u7edd\u5bf9\u6536\u655b\u5728\u5176\u4e2d\u8d77\u5173\u952e\u4f5c\u7528\uff1b\n5|\u5176\u4e8c\u662f\u5b9e\u7ea7\u6570\u66f4\u7cbe\u7ec6\u7684\u5224\u522b\u6cd5\uff08\u963f\u8d1d\u5c14\u6c42\u548c\uff09\uff1b\n6|\u5176\u4e09\u662f\\emph{\u53ef\u548c\u65cf}\u2014\u2014\u6446\u8131\u9879\u7684\u6b21\u5e8f\u7684\u6c42\u548c\u2014\u2014\n7|\u4ee5\u53ca\u4e8c\u91cd\u548c\u7684\u5bcc\u6bd4\u5c3c\u5b9a\u7406\u4e0e\u67ef\u897f\u4e58\u79ef\u3002\n8|\u8fd9\u4e9b\u5de5\u5177\u4e3a\u5176\u540e\u5404\u7ae0\u7684\u51fd\u6570\u9879\u7ea7\u6570\n9|\u63d0\u4f9b\u57fa\u7840\u3002\n10|=\n11|\\section{\u8d4b\u8303\u7a7a\u95f4\u4e2d\u7684\u7ea7\u6570}\n12|=\n13|=\n14|\u8bbe $(u_n)$ \u4e3a\u8d4b\u8303\u7a7a\u95f4 $E$ \u4e2d\u7684\u6570\u5217\uff0c\u7ea7\u6570 $\\sum u_n$\n15|\u5728\u5176\u90e8\u5206\u548c\u6536\u655b\u65f6\u6536\u655b\uff1b\u82e5\u7ea7\u6570\\emph{\u7edd\u5bf9\u6536\u655b}\\index{\u7edd\u5bf9\u6536\u655b!\u5728\u5df4\u62ff\u8d6b\u7a7a\u95f4\u4e2d}\uff0c\n16|\u5373 $\\sum \\norm{u_n} < \\infty$\u3002\n17|\u5728\\emph{\u5df4\u62ff\u8d6b}\u7a7a\u95f4\u4e2d\uff0c\u7edd\u5bf9\u6536\u655b\n18|\u8574\u542b\u6536\u655b\uff08\u89c1\\cref{thm:b2:nvs:absoluteconvergence}\uff09\uff1b\n19|\u5728\u975e\u5b8c\u5907\u7a7a\u95f4\u4e2d\uff0c\u8fd9\u4e00\u7ed3\u8bba\u53ef\u80fd\u5931\u6548\n20|\uff08\u89c1\\cref{exo:b2:series:9}\uff09\u3002\n21|=\n22|=\n23|=\n24|\u5728 $\\mathcal{M}_n(K)$\uff08\u6216 $\\mathcal{L}_c(E)$\uff0c$E$ \u4e3a\u5df4\u62ff\u8d6b\u7a7a\u95f4\uff09\u4e2d\uff1a\n25|\u5bf9 $\\vertiii A < 1$\uff0c\\emph{\u8bfa\u4f0a\u66fc\u7ea7\u6570} $\\sum A^k$\n26|\u7edd\u5bf9\u6536\u655b\u4e8e $(I - A)^{-1}$\uff08\u8bc1\u660e\u89c1\\cref{exo:b2:nvs:5}\uff09\uff1b\n27|$\\sum \\frac{A^k}{k!}$ \u5bf9\u6bcf\u4e2a $A$ \u7edd\u5bf9\u6536\u655b\u4e8e $\\eu^A$\n28|\uff08\u89c1\\cref{ex:b2:nvs:matrixexp}\uff09\u3002\n29|\u7b97\u5b50\u503c\u7684\u51e0\u4f55\u7ea7\u6570\u4e0e\u6307\u6570\u7ea7\u6570\uff0c\u5176\u884c\u4e3a\u4e0e\u6570\u91cf\u60c5\u5f62\u7684\u6a21\u578b\u76f8\u540c\u2014\u2014\n30|\u8fd9\u6b63\u662f\u5df4\u62ff\u8d6b\u6846\u67b6\u7684\u8981\u4e49\u6240\u5728\u3002\n31|=\n32|=\n33|\\section{\u963f\u8d1d\u5c14\u6c42\u548c}\n34|=\n35|\\begin{theorem}[\u963f\u8d1d\u5c14\u6c42\u548c\u4e0e\u5224\u522b\u6cd5]\\label{thm:b2:series:abel}\n36|\uff08\u5206\u90e8\u6c42\u548c\uff09\u5bf9\u6570 $a_n$ \u4e0e\u5411\u91cf $b_n$\uff0c\u8bb0 $B_n\n37|= \\sum_{k=0}^{n} b_k$\uff1a\\index{\u963f\u8d1d\u5c14\u6c42\u548c}\n38|=\n39|=\n40|=\n41|=\n42|\uff08\u963f\u8d1d\u5c14\u5224\u522b\u6cd5\uff09\u82e5 $(a_n)$ \u4e3a\u5b9e\u6570\u5217\uff0c\u5355\u8c03\u9012\u51cf\u8d8b\u4e8e $0$\uff0c\u4e14\n43|\u5176\u90e8\u5206\u548c $B_n$\uff08\u5728\u5df4\u62ff\u8d6b\u7a7a\u95f4\u4e2d\uff09\\emph{\u6709\u754c}\uff0c\u5219\n44|$\\sum a_n b_n$ \u6536\u655b\u3002\n45|=\n46|=\n47|=\n48|\u6052\u7b49\u5f0f\u7684\u8bc1\u660e\u5206\u6b65\u8fdb\u884c\uff1a\u53d6 $B_{-1} = 0$\uff0c\u5199 $b_n = B_n -\n49|$B_{n-1}$\uff0c\u5e76\u4f5c\u62c6\u5206\uff1a\n50|=\n51|=\n52|=\n53|=\n54|=\n55|\u5bf9\u7b2c\u4e8c\u4e2a\u548c\u4f5c\u6307\u6807\u66ff\u6362 $n \\mapsto n + 1$\uff08$B_{-1}$\n56|\u9879\u4e3a\u96f6\uff09\uff1b\u5408\u5e76\u516c\u5171\u6c42\u548c\u8303\u56f4 $0 \\leq n \\leq N-1$\n57|\u5f97 $a_NB_N$ \u52a0\u4e0a $\\sum_{n\\leq N-1}(a_n - a_{n+1})B_n$\uff0c\n58|\u5373\u6240\u8ff0\u516c\u5f0f\u3002\u8fd9\u662f\u79bb\u6563\u5f62\u5f0f\u7684\u5206\u90e8\u79ef\u5206\uff0c\u5176\u4e2d\n59|\u4ee5 $(B_n)$ \u4f5c\u4e3a $(b_n)$ \u7684\u539f\u51fd\u6570\uff0c\u4ee5\u5dee $a_{n+1}\n60|- a_n$ \u4f5c\u4e3a $(a_n)$ \u7684\u5bfc\u6570\u3002\u5bf9\u5224\u522b\u6cd5\uff0c\u8bbe $\\norm{B_n}\n61|\\leq M$\uff0c\u5219\n62|\u8fb9\u754c\u9879 $a_N B_N \\to 0$\uff1b\u7ea7\u6570 $\\sum (a_n -\n63|a_{n+1})B_n$ \u7edd\u5bf9\u6536\u655b\uff0c\u56e0\u4e3a\n64|=\n65|=\n66|=\n67|=\n68|\uff08\u88c2\u9879\u76f8\u6d88\uff0c$a_n \\downarrow 0$\uff09\u3002\u6052\u7b49\u5f0f\u7684\u4e24\u90e8\u5206\n69|\u90fd\u6536\u655b\uff0c\u4ece\u800c $\\sum a_n b_n$ \u6536\u655b\u3002\n70|=\n71|=\n72|=\n73|$\\sum \\frac{\\sin n}{n}$ \u6536\u655b\uff1a\u53d6 $a_n = \\frac1n \\downarrow 0$\uff0c\n74|\u4e14 $B_n = \\sum_{k=1}^{n} \\sin k$ \u6709\u754c\u2014\u2014\u4e8b\u5b9e\u4e0a $B_n =\n75|=\n76|1)}{\\eu^{\\iu} - 1}$\uff0c\u5176\u6a21 $\\leq \\frac{2}{\\abs{\\eu^{\\iu} - 1}}$\u3002\n77|\u5b83\\emph{\u4e0d}\u7edd\u5bf9\u6536\u655b\uff08$\\abs{\\sin n} \\geq \\sin^2 n\n78|= \\frac{1 - \\cos 2n}{2}$\uff0c\u4e14 $\\sum \\frac{1 - \\cos 2n}{2n}$ \u53d1\u6563\uff0c\n79|\u56e0\u4e3a $\\sum \\frac{\\cos 2n}{n}$ \u7531\u540c\u4e00\u963f\u8d1d\u5c14\u5224\u522b\u6cd5\u6536\u655b\uff0c\u800c\n80|$\\sum \\frac{1}{2n}$ \u53d1\u6563\uff09\u3002\u4ea4\u9519\u7ea7\u6570\u5224\u522b\u6cd5\u662f\n81|$b_n = (-1)^n$ \u65f6\u7684\u7279\u6b8a\u60c5\u5f62\u3002\n82|=\n83|=\n84|\\begin{example}[\u6536\u655b\u5706\u5468\u4e0a\u7684\u963f\u8d1d\u5c14\u5224\u522b\u6cd5]\\label{ex:b2:series:abelboundary}\n85|\u5bf9\u54ea\u4e9b\u6ee1\u8db3 $\\abs z = 1$ \u7684\u590d\u6570 $z$\uff0c\u7ea7\u6570 $\\sum_{n \\geq 1}\n86|\\frac{z^n}{n}$ \u6536\u655b\uff1f\u5f53 $z = 1$ \u65f6\uff0c\u5b83\u662f\u8c03\u548c\u7ea7\u6570\uff0c\n87|\u53d1\u6563\u3002\u5bf9\u5706\u5468\u4e0a\u7684 $z \\neq 1$\uff0c\u53ef\u7528\u963f\u8d1d\u5c14\u5224\u522b\u6cd5\uff0c\n88|\u53d6 $a_n = \\frac1n \\downarrow 0$\uff0c$b_n = z^n$\uff0c\u5176\u90e8\u5206\u548c\n89|\u4e0e $N$ \u65e0\u5173\u5730\u6709\u754c\uff1a\n90|=\n91|=\n92|=\n93|=\n94|=\n95|\u6536\u655b\u2014\u2014\u4f46\u4ece\u4e0d\u7edd\u5bf9\u6536\u655b\uff08$\\sum\\frac1n$\uff09\u3002\n96|\u540c\u4e00\u7ea7\u6570\u5728\u5706\u5468\u4e0a\u8868\u73b0\u51fa\u591a\u79cd\u884c\u4e3a\uff1a\u5355\u70b9\u5904\u53d1\u6563\uff0c\n97|\u5176\u4f59\u5404\u70b9\u5904\u6761\u4ef6\u6536\u655b\u3002\u8fd9\u6b63\u662f\u5e42\u7ea7\u6570\u7684\u6807\u51c6\u8fb9\u754c\u884c\u4e3a\n98|\uff08\u89c1\\cref{ch:b2:powerseries}\uff09\uff0c\u6b64\u5904\u4ec5\u7528\u521d\u7b49\u65b9\u6cd5\u7814\u7a76\uff0c\n99|\u5728 $z = -1$ \u65f6\u5b83\u6070\u4e3a\u4ea4\u9519\u8c03\u548c\u7ea7\u6570\uff1b\u5728 $z = \\eu^{\\iu\\theta}$ \u65f6\uff0c\n100|\u5176\u5b9e\u90e8\u4e0e\u865a\u90e8\n101|\u5206\u522b\u4e3a\u7ea7\u6570 $\\sum\\frac{\\cos\n102|n\\theta}{n}$ \u4e0e $\\sum\\frac{\\sin n\\theta}{n}$\uff0c\n103|\u5373\\cref{exo:b2:series:4}\u4e2d\u7684\u7ea7\u6570\u3002\n104|=\n105|=\n106|\\begin{example}[\u6697\u85cf\u9677\u9631\u7684\u4ea4\u9519\u7ea7\u6570]\\label{ex:b2:series:trap}\n107|\u7ea7\u6570 $\\sum_{n\\geq2} \\dfrac{(-1)^n}{\\sqrt n + (-1)^n}$ \u662f\u5426\u6536\u655b\uff1f\n108|\u7b26\u53f7\u4ea4\u66ff\u51fa\u73b0\uff0c\u9879\u8d8b\u4e8e $0$\u2014\u2014\u7136\u800c\n109|\u4ea4\u9519\u5224\u522b\u6cd5\\emph{\u4e0d}\u9002\u7528\uff1a\u5176\u6a21\n110|$\\frac{1}{\\sqrt n + (-1)^n}$ \u5e76\u4e0d\u5355\u8c03\u9012\u51cf\uff08\u5728\u6bcf\u4e2a\u5947\u6570 $n$ \u5904\n111|\u8df3\u5347\uff09\u3002\u6539\u4e3a\u5c55\u5f00\uff1a\n112|=\n113|=\n114|=\n115|=\n116|=\n117|=\n118|=\n119|\u7b2c\u4e00\u9879\u6536\u655b\uff08\u4ea4\u9519\u5224\u522b\u6cd5\uff0c\u5982\u5b9e\u5e94\u7528\u4e8e\n120|$\\frac1{\\sqrt n}\\downarrow0$\uff09\uff0c\u7b2c\u4e09\u9879\u7edd\u5bf9\u6536\u655b\u2014\u2014\n121|\u4f46\u4e2d\u95f4\u4e00\u9879\u662f\u53d1\u6563\u7684\u8c03\u548c\u7ea7\u6570\uff1a\n122|\u5176\u548c\\emph{\u53d1\u6563}\u81f3 $-\\infty$\u3002\u6700\u540e\u7684\u8981\u70b9\u662f\uff1a\u5f53\n123|\u5355\u8c03\u6027\u4e0d\u6210\u7acb\u65f6\uff0c\u5e94\u5c55\u5f00\u81f3\u6bcf\u4e00\u9879\n124|\u8981\u4e48\u7edd\u5bf9\u6536\u655b\uff0c\u8981\u4e48\u662f\u53ef\u76f4\u63a5\u5224\u522b\u7684\u5178\u578b\u60c5\u5f62\uff1b\u9690\u85cf\u7684\n125|$-\\frac1n$ \u5bf9\u7b26\u53f7\u8ba1\u6570\u6cd5\u800c\u8a00\u4e0d\u53ef\u89c1\u3002\n126|=\n127|=",
