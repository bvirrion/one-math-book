f08\n29| \u4e0d\u53d8\u91cf\uff1a\u5408\u540c\u5373\u4e58\u4ee5\u53ef\u9006\u77e9\u9635\uff09\u3002\n30|=\n31|=\n32|=\n33| \u5728 $\\R^2$ \u4e0a\uff1a$q(x, y) = x^2 + 4xy + y^2$ \u7684\u77e9\u9635\u4e3a $\\begin{pmatrix}\n34| 1 & 2\\\\ 2 & 1\\end{pmatrix}$\u3002\u5185\u79ef\u6070\u662f\n35| \u4e8c\u6b21\u578b\u6b63\u5b9a\u7684\u5bf9\u79f0\u53cc\u7ebf\u6027\u578b\uff1b\n36| \u672c\u7ae0\u7814\u7a76\u4e00\u822c\u7684\u3001\u7b26\u53f7\u4e0d\u5b9a\u7684\u60c5\u5f62\u3002\n37|=\n38|=\n39| \\begin{example}[\u5408\u540c\u7684\u4f5c\u7528]\\label{ex:b2:quadratic:congruence}\n40| \u53d6 $q(x, y) = x^2 + 4xy + y^2$\uff08\u77e9\u9635 $B = \\begin{pmatrix} 1\n41| & 2\\\\ 2 & 1\\end{pmatrix}$\uff09\uff0c\u65b0\u57fa\u4e3a $e_1' = (1, 1)$\uff0c\n42| $e_2' = (1, -1)$\uff0c\u5373 $P = \\begin{pmatrix} 1 & 1\\\\ 1 &\n43| -1\\end{pmatrix}$\u3002\u4e8e\u662f\n44|=\n45|=\n46|=\n47|=\n48|=\n49|=\n50|=\n51| \u5728\u65b0\u57fa\u4e0b\u7684\u5750\u6807 $(u, v)$ \u4e2d\uff0c$q = 6u^2 -\n52| 2v^2$ --- \u9a8c\u8bc1\uff1a$x = u + v$\uff0c$y = u - v$ \u4ee3\u5165\u5f97 $x^2 + 4xy +\n53| y^2 = 6u^2 - 2v^2$\uff0c\u76f4\u63a5\u6210\u7acb\u3002\u6ce8\u610f\u65b0\u7684\u5bf9\u89d2\u5143 $6,\n54| -2$ \\emph{\u5e76\u975e} $3, -1$ \u8fd9\u4e24\u4e2a $B$ \u7684\u7279\u5f81\u503c\uff1a\u5408\u540c\n55| \u6539\u53d8\u5c3a\u5ea6\uff0c\u53ea\u6709\u76f8\u4f3c\u624d\u4fdd\u6301\u8c31 --- \u4f46\u7b26\u53f7\n56| \u4e00\u81f4\uff0c\u6b63\u5982\u897f\u5c14\u7ef4\u65af\u7279\u5b9a\u7406\u6240\u8981\u6c42\u7684\u3002\uff08\u8fd9\u91cc\u7684\u57fa\n57| \u662f\u6b63\u4ea4\u7684\u800c\u975e\u6807\u51c6\u6b63\u4ea4\u7684\uff1b\u82e5\u6309\n58| $\\frac{1}{\\sqrt2}$ \u5f52\u4e00\u5316\uff0c\u5219\u5bf9\u89d2\u5143\u9664\u4ee5 $2$\uff0c\n59| \u4fbf\u6062\u590d\u51fa\u7279\u5f81\u503c\u3002\uff09\n60|=\n61|=\n62| \\begin{example}[\u683c\u62c9\u59c6\u884c\u5217\u5f0f\u5ea6\u91cf\u9762\u79ef]\\label{ex:b2:quadratic:gramarea}\n63| \u8bbe $v_1, v_2$ \u4e3a\u6b27\u6c0f\u7a7a\u95f4\u4e2d\u7684\u5411\u91cf\uff0c\u5219\u683c\u62