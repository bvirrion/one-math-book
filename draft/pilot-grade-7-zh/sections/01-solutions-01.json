{"sha": "f745c854fca1118c31cfe417fb8949229345aaf51d76308a9a92abd119e35b66", "body": ["\\section*{第 \\ref{ch:g7:priorities} 章 --- 运算优先级}", "", "\\begin{solution}{exo:g7:priorities:1}", "$5 + 3 \\times 6 = 5 + 18 = 23$.", "", "$(5 + 3) \\times 6 = 8 \\times 6 = 48$.", "", "$30 - 12 \\div 4 = 30 - 3 = 27$.", "", "$(30 - 12) \\div 4 = 18 \\div 4 = 4.5$.", "\\end{solution}", "", "\\begin{solution}{exo:g7:priorities:2}", "$24 - 6 + 2 = 18 + 2 = 20$（从左到右）。", "", "$24 \\div 6 \\times 2 = 4 \\times 2 = 8$（从左到右）。", "", "$24 - 6 \\times 2 = 24 - 12 = 12$（先算乘法）。", "", "$24 \\div (6 \\times 2) = 24 \\div 12 = 2$.", "\\end{solution}", "", "\\begin{solution}{exo:g7:priorities:3}", "$7 + 3 \\times (10 - 6) = 7 + 3 \\times 4 = 7 + 12 = 19$.", "", "$40 - (2 + 3) \\times 4 = 40 - 5 \\times 4 = 40 - 20 = 20$.", "", "$60 \\div \\bigl(2 \\times (7 - 4)\\bigr) = 60 \\div (2 \\times 3)", "= 60 \\div 6 = 10$.", "\\end{solution}", "", "\\begin{solution}{exo:g7:priorities:4}", "$\\dfrac{18 + 6}{8} = \\dfrac{24}{8} = 3$; \\quad", "$\\dfrac{30}{7 - 2} = \\dfrac{30}{5} = 6$; \\quad", "$\\dfrac{5 \\times 8}{4 + 6} = \\dfrac{40}{10} = 4$.", "\\end{solution}", "", "\\begin{solution}{exo:g7:priorities:5}", "$8 \\times 102 = 8 \\times (100 + 2) = 800 + 16 = 816$.", "", "$25 \\times 99 = 25 \\times (100 - 1) = 2500 - 25 = 2475$.", "", "$14 \\times 12 + 14 \\times 8 = 14 \\times (12 + 8) = 14 \\times 20 = 280$.", "", "$37 \\times 45 - 37 \\times 35 = 37 \\times (45 - 35) = 37 \\times 10 =", "370$.", "\\end{solution}", "", "\\begin{solution}{exo:g7:priorities:6}", "“$50$ 与 $6$ 乘以 $7$ 之积的差”：", "$50 - 6 \\times 7 = 50 - 42 = 8$（不需要括号，优先级", "自会起作用）。", "", "“$4$ 与 $5$ 的和，与 $10$ 与", "$8$ 的差之积”：$(4 + 5) \\times (10 - 8) = 9 \\times 2 = 18$。", "\\end{solution}", "", "\\begin{solution}{exo:g7:priorities:7}", "$3 \\times 2.50 + 2 \\times 1.20 = 7.50 + 2.40 = 9.90$ 欧元。", "\\end{solution}", "", "\\begin{solution}{exo:g7:priorities:8}", "(a) 不加括号：$4 + 2 \\times 5 - 1 = 4 + 10 - 1 = 13$。", "", "(b) $(4 + 2) \\times 5 - 1 = 30 - 1 = 29$。", "", "(c) $(4 + 2) \\times (5 - 1) = 6 \\times 4 = 24$。", "\\end{solution}", "", "\\begin{solution}{exo:g7:priorities:9}", "$k = 1$：$12 + 4 \\times 1 = 16$ 和 $16 \\times 1 = 16$ --- 结果一致", "（这正是 $k = 1$ 不能很好检验的原因！）$k = 2$：", "$12 + 4 \\times 2 = 20$，但 $16 \\times 2 = 32$，两者不同。所以这两个", "式子一般\\emph{不}相等。错误的", "等式 $12 + 4 \\times k = 16 \\times k$ 源于先算 $12 + 4$，", "忽略了 $\\times$ 的优先级。", "\\end{solution}", "", "\\begin{solution}{exo:g7:priorities:10}", "\\emph{1.} 团体价：$12 + 6 \\times n$。当 $n = 5$ 时：", "$12 + 30 = 42$ 欧元。", "", "\\emph{2.} 个人价：$9n$。比较：当 $n = 3$ 时，$30$ 与 $27$", "（个人更便宜）；当 $n = 4$ 时，$36$ 与 $36$（相等）；当 $n = 5$ 时，$42$ 与", "$45$（团体更便宜）。从 $5$ 人起，团体价更划算", "（每增加一人，团体价多付 $6$ 而非 $9$，因此差距只会越来越大）。", "\\end{solution}", "", "\\begin{solution}{exo:g7:priorities:11}", "可能的答案（答案不止一种）：", "\\[", "24 = 1 \\times 2 \\times 3 \\times 4, \\qquad", "10 = 1 + 2 + 3 + 4, \\qquad", "1 = (4 - 3) \\times (2 - 1).", "\\]", "\\end{solution}", "", "\\begin{solution}{pb:g7:priorities:1}", "\\textbf{1.} $7 \\times 102 = 7 \\times (100 + 2) = 700 + 14 =", "714$; \\quad $9 \\times 98 = 9 \\times (100 - 2) = 900 - 18 = 882$.", "", "\\textbf{2.} $17 \\times 13 + 17 \\times 7 = 17 \\times (13 + 7) =", "17 \\times 20 = 340$; \\quad $45 \\times 101 - 45 = 45 \\times (101", "- 1) = 45 \\times 100 = 4\\,500$.", "", "\\textbf{3.} $5 \\times 87 = 870 \\div 2 = 435$。合理性：", "$5 = 10 \\div 2$，因此乘以 $5$ 就是先乘以 $10$", "再除以 $2$（$\\times$ 与 $\\div$ 属于同一级，", "从左到右计算即可）。", ""]}