{"sha": "91978f576408b68e0e3eb12310de3ea37610da21f37c4f2022b9e87ab064f6d6", "body": ["\\section{分数乘以一个数}", "", "\\begin{proposition}[分数乘以一个数]\\label{prop:g7:fractions:mult}", "设 $k$ 为一个数：", "\\[", "k \\times \\frac{a}{b} = \\frac{k \\times a}{b} .", "\\]", "求某个量\\emph{的} $\\frac ab$，即是乘以", "$\\frac ab$。", "\\end{proposition}", "\\admitted", "", "\\begin{example}\\label{ex:g7:fractions:mult}", "$6 \\times \\dfrac{2}{3} = \\dfrac{12}{3} = 4$：六的三分之二是", "四个整体。“$\\frac34$ 的 $60$ 欧元”即", "$\\frac34 \\times 60 = \\frac{180}{4} = 45$ 欧元，与先除以 $4$ 再", "乘以 $3$ 所得的结果相同", "（见\\cref{met:g6:fractions:ofquantity}）。", "\\end{example}", "", "\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g7:fractions:1}", "填空：$\\dfrac{2}{5} = \\dfrac{?}{20}$；\\quad", "$\\dfrac{18}{24} = \\dfrac{3}{?}$；\\quad", "$\\dfrac{7}{3} = \\dfrac{28}{?}$；\\quad", "$\\dfrac{?}{9} = \\dfrac{20}{36}$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g7:fractions:2}", "尽可能约分：", "$\\dfrac{12}{16}$；\\quad $\\dfrac{30}{45}$；\\quad $\\dfrac{27}{36}$；", "\\quad $\\dfrac{48}{12}$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g7:fractions:3}", "$\\dfrac{15}{35}$ 与 $\\dfrac{21}{49}$ 相等吗？$\\dfrac{16}{28}$", "与 $\\dfrac{20}{36}$ 呢？通过约分说明理由。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g7:fractions:4}", "比较大小（写出推理过程，而不仅写出答案）：", "\\[", "\\frac{7}{11} \\text{ 与 } \\frac{9}{11}; \\qquad", "\\frac{5}{6} \\text{ 与 } \\frac{11}{18}; \\qquad", "\\frac{13}{12} \\text{ 与 } \\frac{19}{20}.", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g7:fractions:5}", "计算，并在可能时约分：", "\\[", "\\frac{5}{9} + \\frac{2}{9}, \\qquad", "\\frac{11}{7} - \\frac{4}{7}, \\qquad", "\\frac{5}{8} + \\frac{7}{8} .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g7:fractions:6}", "利用\\cref{met:g7:fractions:add}计算：", "\\[", "\\frac{2}{3} + \\frac{5}{6}, \\qquad", "\\frac{7}{10} - \\frac{2}{5}, \\qquad", "\\frac{3}{4} + \\frac{5}{12} .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g7:fractions:7}", "计算：", "\\[", "3 - \\frac{5}{4}, \\qquad", "1 + \\frac{3}{8}, \\qquad", "2 - \\frac{7}{6} .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g7:fractions:8}", "计算：", "\\[", "5 \\times \\frac{3}{10}, \\qquad", "\\frac{7}{8} \\times 4, \\qquad", "\\frac{2}{3} \\text{ 的 } 45 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g7:fractions:9}", "马克吃了一个披萨的 $\\frac14$，朱莉吃了同一个披萨的 $\\frac38$。", "他们一共吃了披萨的几分之几？", "还剩下几分之几？", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g7:fractions:10}", "一瓶果汁有 $\\frac34$ 升。莉亚", "两次各倒出 $\\frac16$ 升。还剩多少果汁？（公分母为 $12$。）", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g7:fractions:11}", "利用\\cref{ex:g7:fractions:trap}中的论证，说明为何", "$\\frac35 + \\frac12$ 不可能等于 $\\frac{4}{7}$，无需计算", "正确的和。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star\\star$]\\label{exo:g7:fractions:12}", "计算下面的和", "\\[", "\\frac12 + \\frac14 + \\frac18 + \\frac{1}{16}", "\\]", "按步骤（从左到右）进行。观察部分和的规律：", "随着越来越多的项", "$\\frac{1}{32}, \\frac{1}{64}, \\dots$ 被加入，它们趋近于什么数？", "\\end{exercise}", ""]}