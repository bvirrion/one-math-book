 "result": "1| \\chapter{\u8fd0\u7b97\u7684\u4f18\u5148\u7ea7}\\label{ch:g7:priorities}\n2|=\n3| $3 + 4 \\times 5$ \u7b49\u4e8e\u591a\u5c11\uff1f\u82e5\u4ece\u5de6\u5230\u53f3\u8ba1\u7b97\uff0c\u5f97 $35$\uff1b\n4| \u82e5\u5148\u505a\u4e58\u6cd5\uff0c\u5219\u5f97 $23$\u3002\u6570\u5b66\u8981\u6c42\u53ea\u6709\u4e00\u4e2a\u7b54\u6848\uff0c\n5| \u56e0\u6b64\u8ba1\u7b97\u9700\u8981\u4e00\u5957\u201c\u4ea4\u901a\u89c4\u5219\u201d --- \u5373\u4f18\u5148\u7ea7\u3002\n6| \u672c\u7ae0\u7ed9\u51fa\u8fd9\u4e9b\u89c4\u5219\uff0c\u5e76\u5f15\u5165\u7b2c\u4e00\u4e2a\u4ee3\u6570\u6052\u7b49\u5f0f\uff0c\n7| \u5373\u5206\u914d\u5f8b\u3002\n8|=\n9| \\section{\u4f18\u5148\u7ea7\u89c4\u5219}\n10|=\n11| \\begin{theorem}[\u4f18\u5148\u7ea7\u89c4\u5219]\\label{thm:g7:priorities:rules}\n12| \u5728\u4e0d\u542b\u62ec\u53f7\u7684\u8fd0\u7b97\u4e2d\uff1a\n13|=\n14|   \\item \u4e58\u6cd5\u548c\u9664\u6cd5\\emph{\u5148\u4e8e}\n15|         \u52a0\u6cd5\u548c\u51cf\u6cd5\u8fdb\u884c\uff1b\n16|   \\item \u540c\u7ea7\u8fd0\u7b97\u6309\u4ece\u5de6\u5230\u53f3\u7684\u987a\u5e8f\u8fdb\u884c\u3002\n17|=\n18| \u62ec\u53f7\u5185\u7684\u8fd0\u7b97\u4f18\u5148\u4e8e\u5176\u4ed6\u4e00\u5207\uff1a\u5148\u7b97\u62ec\u53f7\u5185\u7684\u90e8\u5206\uff0c\n19| \u5e76\u4ece\u6700\u5185\u5c42\u62ec\u53f7\u5f00\u59cb\u3002\n20|=\n21|=\n22|=\n23| \u6bcf\u884c\u53ea\u505a\u4e00\u6b65\uff0c\u5e76\u5728\u5fc3\u4e2d\u6807\u51fa\u5f53\u524d\u8ba1\u7b97\u7684\u90e8\u5206\uff1a\n24|=\n25|=\n26| &&\\text{\uff08\u5148\u505a\u4e58\u6cd5\uff09}\\\\\n27|=\n28| &&\\text{\uff08\u540c\u7ea7\u8fd0\u7b97\uff1a\u4ece\u5de6\u5230\u53f3\uff09}\\\\\n29|=\n30| &&\\text{\uff08\u540c\u7ea7\u8fd0\u7b97\uff1a\u4ece\u5de6\u5230\u53f3\uff09}\\\\\n31|=\n32| &&\\text{\uff08\u5148\u7b97\u62ec\u53f7\uff09\u3002}\n33|=\n34| \u6ce8\u610f\u6613\u9519\u4e4b\u5904\uff1a$20 - 8 + 2$ \\emph{\u5e76\u4e0d\u7b49\u4e8e} $20 - 10$\uff0c\n35| \u800c $18 \\div 3 \\times 2$ \\emph{\u5e76\u4e0d\u7b49\u4e8e} $18 \\div 6$\u3002\n36|=\n37|=\n38| \\begin{example}[\u591a\u5c42\u62ec\u53f7]\\label{ex:g7:priorities:nested}\n39|=\n40|=\n41| &= 50 - 2 \\times (3 + 6) && \\text{\uff08\u6700\u5185\u5c42\u62ec\u53f7\uff09}\\\\\n42| &= 50 - 2 \\times 9 && \\text{\uff08\u5269\u4e0b\u7684\u62ec\u53f7\uff09}\\\\\n43| &= 50 - 18 && \\text{\uff08\u4e58\u6cd5\uff09}\\\\\n44|=\n45|=\n46|=\n47|=\n48| \\begin{remark}[\u5206\u6570\u7ebf\u4f1a\u9690\u85cf\u62ec\u53f7]\n49| \u5206\u6570\u7ebf\u5c06\u5206\u5b50\u4e0e\u5206\u6bcd\u5404\u81ea\u89c6\u4e3a\u4e00\u7ec4\uff0c\n50| \u4eff\u4f5b\u5404\u81ea\u5e26\u6709\u770b\u4e0d\u89c1\u7684\u62ec\u53f7\uff1a\n51|=\n52|=\n53| \\qquad\\text{\u800c\u975e}\\quad 12 + \\frac{8}{4} = 14 .\n54|=\n55|=\n56|=\n57| \\begin{method}[\u5b89\u5168\u8ba1\u7b97]\\label{met:g7:priorities:safe}\n58|=\n59|   \\item \u627e\u51fa\u5e94\u5148\u8fdb\u884c\u7684\u8fd0\u7b97\uff08\u4f9d\u6b21\u4e3a\u6700\u5185\u5c42\u62ec\u53f7\u3001\n60|         $\\times$ \u4e0e $\\div$\u3001$+$ \u4e0e $-$\uff09\uff1b\n61|   \\item \\emph{\u53ea\u8ba1\u7b97\u8fd9\u4e00\u6b65}\uff0c\u5e76\u5c06\u6574\u4e2a\u5f0f\u5b50\u6539\u5199\u4e3a\n62|         \u7ed3\u679c\u653e\u5728\u539f\u4f4d\u540e\u7684\u5f62\u5f0f\uff1b\n63|   \\item \u91cd\u590d\u4e0a\u8ff0\u6b65\u9aa4\uff0c\u76f4\u5230\u53ea\u5269\u4e00\u4e2a\u6570 --- \u6bcf\u884c\u53ea\u505a\u4e00\u6b65\u8fd0\u7b97\uff0c\n64|         \u4e0d\u8df3\u6b65\u3002\n65|=\n66|=\n67|=\n68| \\section{\u5206\u914d\u5f8b}\n69|=\n70| \\begin{theorem}[\u5206\u914d\u5f8b]\\label{thm:g7:priorities:distributivity}\n71| \u5bf9\u6240\u6709\u6570 $k$\u3001$a$\u3001$b$\uff1a\n72|=\n73|=\n74|=\n75|=\n76|=\n77|=\n78|=\n79| \\begin{proof}[\u56fe\u5f62\u8bc1\u660e]\n80| \u8ba1\u7b97\u5bbd\u4e3a $k$ \u7684\u957f\u65b9\u5f62\u7684\u9762\u79ef\uff0c\u8be5\u957f\u65b9\u5f62\u88ab\u5206\u4e3a\u4e24\u4e2a\n81| \u8f83\u5c0f\u7684\u957f\u65b9\u5f62\uff0c\u957f\u5206\u522b\u4e3a $a$ \u548c $b$\uff1a\u6574\u4f53\u9762\u79ef\u4e3a $k \\times (a+b)$\uff1b\n82| \u5206\u4e24\u90e8\u5206\u8ba1\u7b97\u65f6\u4e3a $k \\times a + k \\times b$\u3002\u540c\u4e00\u4e2a\u957f\u65b9\u5f62\uff0c\n83| \u9762\u79ef\u81ea\u7136\u76f8\u540c\u3002\n84|=\n85|=\n86|=\n87|=\n88|=\n89|=\n90|=\n91|=\n92|=\n93|=\n94|=\n95|=\n96|=\n97|=\n98|=\n99| {\\small \u5206\u914d\u5f8b\u7684\u9762\u79ef\u89e3\u91ca\uff1a\u5927\u957f\u65b9\u5f62\n100| $k \\times (a + b)$ \u6070\u4e3a\u4e24\u4e2a\u8f83\u5c0f\u957f\u65b9\u5f62\u9762\u79ef\u4e4b\u548c\u3002}\n101|=\n102|=\n103| \\begin{example}[\u4e24\u4e2a\u65b9\u5411]\\label{ex:g7:priorities:distributivity}\n104| \\emph{\u5c55\u5f00}\uff08\u4ece\u5de6\u5230\u53f3\uff09\u4f7f\u5fc3\u7b97\u53d8\u5f97\u5bb9\u6613\uff1a\n105|=\n106|=\n107|=\n108|=\n109|=\n110| \\emph{\u63d0\u53d6\u516c\u56e0\u5f0f}\uff08\u4ece\u53f3\u5230\u5de6\uff09\u53ef\u628a\u516c\u56e0\u5f0f\u96c6\u4e2d\u8d77\u6765\uff1a\n111|=\n112|=\n113|=\n114|=\n115|=",
