{"sha": "f530d2337293a4d8210e06f0bb0205a04af028879bc9097dc9faf3a120a02d99", "body": ["\\begin{example}\\label{ex:g1:tens:compare}", "将 $35$、$53$、$29$ 排序，先比较十位（$2$、$3$、$5$）：", "\\[", "29 < 35 < 53 .", "\\]", "\\end{example}", "", "\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:tens:1}", "下列各数分别有几个十和几个一：$26$；\\ $40$；\\ $73$；\\ $99$？", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:tens:2}", "写出下列各数：$5$ 个十和 $2$ 个一；\\ $8$ 个十；\\ $1$ 个十和", "$9$ 个一；\\ $10$ 个十。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:tens:3}", "用数字写出：六十三；\\ 四十；\\ 八十五；\\ 一", "百。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:tens:4}", "借助百数表计算：$23 + 10$；\\quad $67 + 10$；", "\\quad $45 - 10$；\\quad $80 - 10$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:tens:5}", "续写下列各数：$10, 20, 30, ?, ?, ?$。\\quad", "$5, 10, 15, ?, ?, ?$。\\quad $12, 14, 16, ?, ?, ?$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:tens:6}", "抄写并在空格处填上 $<$ 或 $>$：", "\\[", "34 \\;?\\; 43, \\qquad", "58 \\;?\\; 61, \\qquad", "70 \\;?\\; 69, \\qquad", "99 \\;?\\; 100 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:tens:7}", "按从小到大的顺序排列：$46$；\\ $19$；\\ $64$；\\ $91$；\\", "$41$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:tens:8}", "一位园丁把 $52$ 朵花每十朵扎成一束，", "能扎成几束整束？还剩几朵散花？", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g1:tens:9}", "在百数表上从 $36$ 出发，向下走两步，", "再向左走一步，到达哪个数？刚才做的是哪种计算？", "\\end{exercise}", ""]}