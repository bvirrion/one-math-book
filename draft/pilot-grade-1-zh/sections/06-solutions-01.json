{"sha": "8f59dee1833b0c65ac58f6fc0da852a8c18f25c8d892cd95134392db4a2c9f76", "body": ["\\section*{第 \\ref{ch:g1:measure} 章 --- 测量与时间}", "", "\\begin{solution}{exo:g1:measure:1}", "答案取决于铅笔；当铅笔的一端对齐时，", "最长的伸得最远，最短的伸得最近。", "\\end{solution}", "", "\\begin{solution}{exo:g1:measure:2}", "答案各不相同；读数时把尺子的 $0$ 对准物体的起点，", "并读出物体另一端所对的整厘米数。", "\\end{solution}", "", "\\begin{solution}{exo:g1:measure:3}", "星期一的后一天是星期二，星期日的前一天是星期六，", "星期五之后两天是星期日。", "\\end{solution}", "", "\\begin{solution}{exo:g1:measure:4}", "昨天是星期三，明天是星期五，三天后是星期日。", "\\end{solution}", "", "\\begin{solution}{exo:g1:measure:5}", "在 $6$ 点整时，时针指向 $6$，", "分针指向 $12$。", "\\end{solution}", "", "\\begin{solution}{exo:g1:measure:6}", "时针指向 $5$：$5$ 点。时针指向 $11$：$11$ 点。", "\\end{solution}", "", "\\begin{solution}{exo:g1:measure:7}", "对于 $8$，例如 $5 + 2 + 1$ 或 $2 + 2 + 2 + 2$，", "（还有其他正确答案）。", "\\end{solution}", "", "\\begin{solution}{exo:g1:measure:8}", "$5 + 2 + 2 + 2 = 11$。利奥共有 $11$。", "\\end{solution}", "", "\\begin{solution}{exo:g1:measure:9}", "从 $3$ 到 $5$ 相差 $2$，佐伊应找回 $2$。", "\\end{solution}", ""]}