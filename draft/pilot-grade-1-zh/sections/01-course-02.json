{"sha": "019f5be5a5b54afc5a496f62fc601e53367ab7d489ffeed197229ee7fa024870", "body": ["\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:counting:1}", "数一数你名字中有几个字母。", "数一数两只手有几根手指，数一数两只猫有几条腿。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:counting:2}", "用数字写出：七；\\ 十二；\\ 二十；\\ 零。用汉字写出：", "$4$；\\ $15$；\\ $18$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:counting:3}", "接着数下去：$8,\\ 9,\\ 10,\\ ?,\\ ?,\\ ?$。倒着数：", "$15,\\ 14,\\ 13,\\ ?,\\ ?,\\ ?$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:counting:4}", "$10$ 的前一个数是哪一个？$16$ 的后一个数是哪一个？", "$12$ 和 $14$ 之间的数是哪一个？", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:counting:5}", "照样子抄写，并用 $<$ 或 $>$ 填空：", "\\[", "6 \\;?\\; 9, \\qquad", "14 \\;?\\; 8, \\qquad", "11 \\;?\\; 13, \\qquad", "20 \\;?\\; 19 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:counting:6}", "画出 $6$ 个圆和 $8$ 个叉，通过配对，", "哪一种更多？多几个？", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:counting:7}", "从小到大排列：$12$；\\ $7$；\\ $17$；\\ $2$；\\ $10$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g1:counting:8}", "五个小朋友排成一队：爱丽丝、鲍勃、克莱奥、丹、艾玛。", "谁排第二？谁排第四？丹排在第几位？", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g1:counting:9}", "我是一个介于 $10$ 和 $20$ 之间的数。", "按数线数，我在 $13$ 之后第三步的位置。", "我是谁？而在 $13$ 的\\emph{之前}第三步的数是谁？", "\\end{exercise}", ""]}