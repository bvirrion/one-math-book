{"sha": "623775ad14013db01664c3d32964e6909532e8bc4b983a27bc87f3bfe0476ad2", "body": ["\\section*{第 \\ref{ch:g1:addition} 章 --- 加法：初步}", "", "\\begin{solution}{exo:g1:addition:1}", "$4 + 3 = 7$; \\quad $5 + 2 = 7$; \\quad $6 + 4 = 10$.", "\\end{solution}", "", "\\begin{solution}{exo:g1:addition:2}", "$3 + 8 = 11$（从 $8$ 开始，接着数 $3$）；\\quad", "$2 + 12 = 14$; \\quad $4 + 9 = 13$.", "\\end{solution}", "", "\\begin{solution}{exo:g1:addition:3}", "十的伙伴：$7 \\to 3$； \\ $4 \\to 6$； \\ $9 \\to 1$； \\ $5 \\to 5$；", "\\ $1 \\to 9$。", "\\end{solution}", "", "\\begin{solution}{exo:g1:addition:4}", "$9 + 4 = 13$（$9 + 1 = 10$，再 $+3$）；\\quad", "$8 + 7 = 15$（$8 + 2 = 10$，再 $+5$）；\\quad", "$6 + 5 = 11$（$6 + 4 = 10$，再 $+1$）。", "\\end{solution}", "", "\\begin{solution}{exo:g1:addition:5}", "$7 + 8 = 15$（比 $7 + 7 = 14$ 多一）；\\quad", "$5 + 6 = 11$（比 $5 + 5$ 多一）；\\quad", "$9 + 8 = 17$（比 $9 + 9 = 18$ 少一）。", "\\end{solution}", "", "\\begin{solution}{exo:g1:addition:6}", "$6 + 4 = 10$; \\quad $7 + 5 = 12$; \\quad $10 + 7 = 17$.", "\\end{solution}", "", "\\begin{solution}{exo:g1:addition:7}", "$8 + 5 = 13$。公共汽车上有 $13$ 人。", "\\end{solution}", "", "\\begin{solution}{exo:g1:addition:8}", "汤姆有 $6 + 7 = 13$ 辆车，米娅有 $10$ 辆，汤姆的车多。", "\\end{solution}", "", "\\begin{solution}{exo:g1:addition:9}", "先算十的伙伴 $4$ 和 $6$：$4 + 6 = 10$，然后", "$10 + 5 = 15$。和为 $15$。", "\\end{solution}", ""]}