{"sha": "c0b12cef172163eb4ae5411874ca4483684529a97a544f66f1929eab736eccce", "body": ["\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:decimals:1}", "在百格图中，若涂色的是：$5$ 列；", "$2$ 列和 $3$ 格；$45$ 格。涂色部分各占多少？用分数作答。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:decimals:2}", "用小数表示：", "$\\frac{9}{10}$; \\quad $\\frac{27}{100}$; \\quad $\\frac{3}{100}$; \\quad", "$5 + \\frac{6}{10}$; \\quad $\\frac{60}{100}$.", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:decimals:3}", "写成分数（十分之几或百分之几）：", "$0.3$; \\quad $0.51$; \\quad $0.07$; \\quad $1.9$.", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:decimals:4}", "在 $6.58$ 中，数字 $5$ 表示的是多少个什么？数字 $8$ 呢？", "仿照\\cref{def:g4:decimals:point}，将该数分解。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:decimals:5}", "在从 $4$ 到 $5$、以十分之一为刻度的数轴上标出：", "$4.2$；\\ $4.75$（位于哪两个刻度之间？）；\\ $4.9$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:decimals:6}", "抄写并在空格处填入 $<$、$>$ 或 $=$：", "\\[", "0.6 \\;?\\; 0.60, \\qquad", "2.8 \\;?\\; 2.75, \\qquad", "0.09 \\;?\\; 0.1, \\qquad", "5.3 \\;?\\; 5.13 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:decimals:7}", "从小到大排序：$1.05$；\\ $1.5$；\\ $0.95$；\\ $1.45$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:decimals:8}", "用小数写出：三欧元五分；十二欧元", "五十分；九十九分。然后将这三个价格排序。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:decimals:9}", "哪些一位小数严格位于", "$3$ 与 $4$ 之间？请全部列出。共有多少个？", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g4:decimals:10}", "汤姆说：“$0.25$ 比 $0.5$ 大，因为 $25$ 比", "$5$ 大。”请借助百格图向他指出错误（", "每个数各涂了多少格？）。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g4:decimals:11}", "一名运动员三次跳远的成绩分别是 $3.6$ m、$3.58$ m 和 $3.65$ m。", "将这三次成绩从短到长排序。哪两次相差", "恰好为 $\\frac{5}{100}$ 米？", "\\end{exercise}", ""]}