{"sha": "1b582e45d2e029eecb9c134155fa9abf88ff8dcfb6add88978bf92aa7ce30e82", "body": ["\\section*{第 \\ref{ch:g4:division} 章 --- 除法}", "", "\\begin{solution}{exo:g4:division:1}", "$96 \\div 4$：介于 $4 \\times 20 = 80$ 与 $4 \\times 30 = 120$ 之间，所以", "商是两位数；竖式计算得 $24$，余数", "为 $0$。", "", "$87 \\div 5$：介于 $5 \\times 10 = 50$ 与 $5 \\times 20 = 100$ 之间；", "商为 $17$，余数为 $2$（$87 = 5 \\times 17 + 2$）。", "\\end{solution}", "", "\\begin{solution}{exo:g4:division:2}", "$672 \\div 4 = 168$，余数为 $0$（验算：$4 \\times 168 = 672$）。", "", "$925 \\div 7 = 132$，余数为 $1$（验算：", "$7 \\times 132 + 1 = 925$）。", "", "$804 \\div 6 = 134$，余数为 $0$（验算：$6 \\times 134 = 804$）。", "\\end{solution}", "", "\\begin{solution}{exo:g4:division:3}", "$816 \\div 4 = 204$（十位上 $1 \\div 4$ 不够除 ——", "写上 $0$）。", "", "$420 \\div 7 = 60$。", "", "$2\\,512 \\div 5 = 502$，余数为 $2$（验算：", "$5 \\times 502 + 2 = 2\\,512$）。", "\\end{solution}", "", "\\begin{solution}{exo:g4:division:4}", "$85 = 9 \\times 9 + 4$（商为 $9$，余数为 $4$）。", "", "$1\\,000 = 3 \\times 333 + 1$.", "\\end{solution}", "", "\\begin{solution}{exo:g4:division:5}", "$156 \\div 6 = 26$：装满二十六个盒子，没有剩余。", "\\end{solution}", "", "\\begin{solution}{exo:g4:division:6}", "$250 = 8 \\times 31 + 2$：可以切成三十一段，", "还剩 $2$ 厘米的丝带。", "\\end{solution}", "", "\\begin{solution}{exo:g4:division:7}", "$375 = 52 \\times 7 + 11$：七辆公交车载 $364$ 名学生，", "还剩 $11$ 名学生——“多一辆”的情形：需要 $8$ 辆公交车。", "\\end{solution}", "", "\\begin{solution}{exo:g4:division:8}", "$234 \\div 3 = 78$：每人分得 $78$ 颗弹珠。验算：", "$3 \\times 78 = 234$。", "\\end{solution}", "", "\\begin{solution}{exo:g4:division:9}", "被除数 $= 7 \\times 58 + 3 = 406 + 3 = 409$。", "\\end{solution}", "", "\\begin{solution}{exo:g4:division:10}", "层数：$438 = 9 \\times 48 + 6$：装满 $48$ 层，还多 $6$ 本书，", "共需 $49$ 层。书柜：", "$49 = 6 \\times 8 + 1$：装满八个书柜，还多一层——", "需购买 $9$ 个书柜。", "\\end{solution}", "", "\\begin{solution}{exo:g4:division:11}", "商 $=$ 余数 $= r$，$r < 8$，所以 $r$ 取 $0, 1, \\dots,", "7$，被除数为 $8r + r = 9r$，可能的被除数有", "$0$, $9$, $18$, $27$, $36$, $45$, $54$, $63$.", "\\end{solution}", ""]}