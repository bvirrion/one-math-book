{"sha": "e0b096808b5358ff8209cf1e0ed8f7e337b8e0297a28cd55640dc8d80950ea1d", "body": ["\\begin{example}[公平分钱]\\label{ex:g4:division:money}", "四个朋友平均分担一件礼物的 $92$ 元费用：", "$92 \\div 4 = 23$ 恰好除尽（余数为 $0$）。每人付 $23$。当", "余数为零时，除法“正好除尽”，分配", "十分公平。", "\\end{example}", "", "\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:division:1}", "仿照\\cref{ex:g4:division:size}，判断每个商", "介于哪两个“整”数之间？再用竖式计算：", "$96 \\div 4$；\\quad $87 \\div 5$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:division:2}", "用竖式计算下列除法，并检验每一题：", "$672 \\div 4$；\\quad $925 \\div 7$；\\quad $804 \\div 6$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:division:3}", "注意零的处理（见\\cref{ex:g4:division:zero}）：", "$816 \\div 4$；\\quad $420 \\div 7$；\\quad $2\\,512 \\div 5$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:division:4}", "写出下列除法的检验等式（$a = b \\times q + r$）：$85 \\div 9$；", "\\quad $1\\,000 \\div 3$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:division:5}", "把 $156$ 个鸡蛋装入每箱 $6$ 个的箱子中。能装满的箱子有几个？", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:division:6}", "一根长 $250$ cm 的丝带，剪成每段 $8$ cm 的小段，能剪几段，", "还剩多长？", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:division:7}", "$375$ 名学生乘坐每辆有 $52$ 个座位的大巴去看演出，需要几", "辆大巴？（判断这是", "\\cref{met:g4:division:interpret}中的哪一种情况？用 $52$ 的倍数做除法：", "$52 \\times 7 = 364$。）", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:division:8}", "三个朋友平均分 $234$ 颗弹珠。每人分到几颗？", "用乘法检验。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:division:9}", "求被除数：用 $7$ 去除，商为 $58$，", "余数为 $3$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g4:division:10}", "图书管理员要摆放 $438$ 本书，每层书架放 $9$ 本。", "每个书柜配 $6$ 层书架。需要几层书架？需要买几", "个书柜？（两次除法，都要", "考虑“再多一个”的问题。）", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g4:division:11}", "用 $8$ 去除某数，商恰好等于余数。", "所有可能的被除数是多少？请全部列出。（余数必须", "小于 $8$。）", "\\end{exercise}", ""]}