{"sha": "1e94ce415cd430dfc4b3cb509e3ea258e9e6ad56c5481a2a4bf7a33e3c4599db", "body": ["\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:mult:1}", "口算：$47 \\times 10$；\\quad $23 \\times 100$；\\quad", "$36 \\times 20$；\\quad $15 \\times 300$；\\quad $42 \\times 50$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:mult:2}", "仿照\\cref{ex:g4:mult:why}，用拆分法计算 $34 \\times 21$，", "（$34 \\times 21 = 34 \\times 20 + 34$），再用竖式验算。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:mult:3}", "用竖式计算：$63 \\times 24$；\\quad $85 \\times 47$；\\quad", "$126 \\times 53$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:mult:4}", "先估算，再用竖式计算：$208 \\times 34$；\\quad", "$517 \\times 62$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:mult:5}", "运用\\cref{ex:g4:mult:tricks}中的技巧计算：", "$45 \\times 11$；\\quad $32 \\times 99$；\\quad $24 \\times 45$（先加倍", "再减半 --- 愿意的话也可以做两次）。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:mult:6}", "某影院有 $26$ 排，每排 $18$ 个座位。一共有多少个座位？", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:mult:7}", "一辆卡车运送 $32$ 个托盘，每个托盘装 $48$ 箱。", "共有多少箱？请先估算，再给出精确答案。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g4:mult:8}", "找出错误：安娜计算 $57 \\times 23$ 时，", "算出 $57 \\times 3 = 171$ 和 $57 \\times 2 = 114$，然后相加得 $171 + 114 = 285$。", "正确答案是 $1\\,311$。她漏掉了", "什么？", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g4:mult:9}", "一位园丁种下 $14$ 行、每行 $35$ 株郁金香，以及 $12$ 行、", "每行 $28$ 株水仙。一共有多少朵花？（先求两个积，再求和。）", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g4:mult:10}", "一家面包房每天用面粉 $67$ 千克。一个 $30$ 天的月份", "大约需要多少面粉？先用取整后的数估算，", "再精确计算。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g4:mult:11}", "仿照本章的长方形图，解释为什么", "$15 \\times 12$ 可以写成 $15 \\times 10 + 15 \\times 2$ 来计算。", "再设计另一种同样正确的 $15 \\times 12$ 的拆分。", "\\end{exercise}", ""]}