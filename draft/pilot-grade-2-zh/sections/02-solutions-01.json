{"sha": "ad267db6e355c31fd722fbc1afce14ad117149727e006922acfb646e42e97195", "body": ["\\section*{第 \\ref{ch:g2:addition} 章 --- 进位加法}", "", "\\begin{solution}{exo:g2:addition:1}", "$34 + 25 = 59$; \\quad $126 + 43 = 169$; \\quad $507 + 82 = 589$.", "\\end{solution}", "", "\\begin{solution}{exo:g2:addition:2}", "$47 + 8 = 55$; \\quad $56 + 27 = 83$; \\quad $65 + 19 = 84$.", "\\end{solution}", "", "\\begin{solution}{exo:g2:addition:3}", "$268 + 145 = 413$; \\quad $374 + 158 = 532$; \\quad", "$429 + 293 = 722$.", "\\end{solution}", "", "\\begin{solution}{exo:g2:addition:4}", "$38 + 5 = 38 + 2 + 3 = 43$; \\quad $67 + 6 = 67 + 3 + 3 = 73$; \\quad", "$54 + 8 = 54 + 6 + 2 = 62$.", "\\end{solution}", "", "\\begin{solution}{exo:g2:addition:5}", "$42 + 36 = 70 + 8 = 78$; \\quad $53 + 24 = 70 + 7 = 77$; \\quad", "$61 + 28 = 80 + 9 = 89$.", "\\end{solution}", "", "\\begin{solution}{exo:g2:addition:6}", "$58 + 34$：估算 $60 + 30 = 90$；准确值为 $92$。", "$296 + 187$：估算 $300 + 200 = 500$；准确值为 $483$。", "\\end{solution}", "", "\\begin{solution}{exo:g2:addition:7}", "$128 + 95 = 223$。两人一共有 $223$ 颗弹珠。", "\\end{solution}", "", "\\begin{solution}{exo:g2:addition:8}", "第一个数加 $27$ 得 $64$，所以它是 $64 - 27 = 37$：", "缺少的个位数字是 $7$（这个数是 $37$）。", "\\end{solution}", "", "\\begin{solution}{exo:g2:addition:9}", "儿童：$27 + 28 = 55$；加上大人共 $55 + 6 = 61$", "人。", "\\end{solution}", "", "\\begin{solution}{exo:g2:addition:10}", "$27$ 和 $33$ 的个位分别是 $7$ 和 $3$（十个朋友）：", "$27 + 33 = 60$，然后 $60 + 40 = 100$。三个数是", "$27$、$33$ 和 $40$。", "\\end{solution}", ""]}