{"sha": "505904f3041205f182fe4e52758348b9862a4d7abd328289920f1af004306543", "body": ["\\begin{exercise}[$\\star$]\\label{exo:g2:numbers:4}", "按\\cref{def:g2:numbers:places}的方法分解：$438$；\\ $702$；\\", "$560$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g2:numbers:5}", "抄写下列各式，并在空处填入 $<$ 或 $>$：", "\\[", "327 \\;?\\; 372, \\qquad", "580 \\;?\\; 508, \\qquad", "199 \\;?\\; 200, \\qquad", "640 \\;?\\; 604 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g2:numbers:6}", "从小到大排列：$430$；\\ $304$；\\ $340$；\\ $403$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g2:numbers:7}", "用跳数线的方法计算：$253 + 10$；\\quad $253 + 100$；", "\\quad $480 - 10$；\\quad $716 - 100$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g2:numbers:8}", "接着数下去：$195, 205, 215, ?, ?$。\\quad", "$300, 400, 500, ?, ?$。\\quad 第一题要细心哦！", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g2:numbers:9}", "一家商店有 $6$ 盒铅笔，每盒 $100$ 支，还有", "$5$ 支散放的铅笔。一共有多少支铅笔？", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g2:numbers:10}", "用数字 $2$、$5$ 和 $8$ 各用一次，写出最大的", "三位数和最小的三位数。它们相差多少？", "（可以用数线跳着计算。）", "\\end{exercise}", ""]}