{"sha": "dcb17545777069343ffae3735fb3c711d6fcef37f87304c21226dc170d6de13b", "body": ["\\section*{第 \\ref{ch:g3:addsub} 章 --- 加法与减法}", "", "\\begin{solution}{exo:g3:addsub:1}", "$346 + 253 = 599$; \\quad", "$478 + 265 = 743$; \\quad", "$1\\,536 + 2\\,876 = 4\\,412$.", "\\end{solution}", "", "\\begin{solution}{exo:g3:addsub:2}", "$587 - 234 = 353$（验算：$353 + 234 = 587$）。", "", "$805 - 348 = 457$（验算：$457 + 348 = 805$）。", "", "$1\\,000 - 463 = 537$（验算：$537 + 463 = 1\\,000$）。", "\\end{solution}", "", "\\begin{solution}{exo:g3:addsub:3}", "$38 + 7 = 38 + 2 + 5 = 45$; \\quad", "$56 + 9 = 56 + 4 + 5 = 65$; \\quad", "$45 + 28 = 45 + 30 - 2 = 73$.", "\\end{solution}", "", "\\begin{solution}{exo:g3:addsub:4}", "$340 + 220 = 560$; \\quad $675 + 210 = 885$; \\quad", "$512 - 300 = 212$; \\quad $840 - 220 = 620$.", "\\end{solution}", "", "\\begin{solution}{exo:g3:addsub:5}", "从 $47$ 到 $50$：$3$；从 $50$ 到 $63$：$13$；合计", "$3 + 13 = 16$。竖式验算：$63 - 47 = 16$。", "\\end{solution}", "", "\\begin{solution}{exo:g3:addsub:6}", "$492 + 218$：估算 $500 + 200 = 700$；准确结果为 $710$。", "", "$913 - 388$：估算 $900 - 400 = 500$；准确结果为 $525$。", "\\end{solution}", "", "\\begin{solution}{exo:g3:addsub:7}", "$348 + 296 = 644$。学校有 $644$ 名学生。", "\\end{solution}", "", "\\begin{solution}{exo:g3:addsub:8}", "$224 - 178 = 46$。诺拉还需要读 $46$ 页。", "\\end{solution}", "", "\\begin{solution}{exo:g3:addsub:9}", "个位：$7 + \\text{?} = 2$ 不可能，故 $7 + 5 = 12$，", "个位上的空格为 $5$，向十位进 $1$。十位：$\\text{?} + 2 + 1 = 6$，十位上的空格为", "$3$（不进位）。百位：$3 + \\text{?} = 8$，百位上的空格为", "$5$。因此 $337 + 525 = 862$，每个空格都只有一个可能的数字，", "即只有这一种填法。", "\\end{solution}", "", "\\begin{solution}{exo:g3:addsub:10}", "已售出：$145 + 89 = 234$ 个牛角包。烤制总数为已售出与未售出之和，", "$234 + 17 = 251$ 个牛角包。", "\\end{solution}", "", "\\begin{solution}{exo:g3:addsub:11}", "他说得对：$500 - 200 = 300$，再加 $1$ 得 $301$；竖式计算，", "也得 $500 - 199 = 301$。减去 $200$ 时，\\emph{多减了一个}，", "因此要补回来。--- 先减一个好算的相近数再修正，", "往往比退位相减更快。", "\\end{solution}", ""]}