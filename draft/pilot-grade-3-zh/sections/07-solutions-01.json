{"sha": "54271c54eb89a00d64c3ee264c2f1532913e1c1abedfdf1c741fd7633a7a7d36", "body": ["\\section*{第 \\ref{ch:g3:problems} 章 --- 解决问题}", "", "\\begin{solution}{exo:g3:problems:1}", "飞来的鸟群：加法。分樱桃：除法。", "几盒铅笔：乘法。送出的卡片：减法。", "\\end{solution}", "", "\\begin{solution}{exo:g3:problems:2}", "所求：现在车的数量。已知 $246$ 辆，之后又多 $158$ 辆。", "运算：加法。计算：$246 + 158 = 404$。答：", "停车场里现在有 $404$ 辆车。", "\\end{solution}", "", "\\begin{solution}{exo:g3:problems:3}", "包含除：$90 \\div 9 = 10$。这根绳子可以剪成 $10$ 段。", "\\end{solution}", "", "\\begin{solution}{exo:g3:problems:4}", "乘法：$26 \\times 8 = 208$。门票共需 $208$。", "\\end{solution}", "", "\\begin{solution}{exo:g3:problems:5}", "比较条形图：艾玛的条形为 $64$，雨果的条形比她短 $29$。", "减法：$64 - 29 = 35$。雨果有 $35$ 张贴纸。", "\\end{solution}", "", "\\begin{solution}{exo:g3:problems:6}", "收到的苹果：$6 \\times 45 = 270$ 个。剩下：", "$270 - 178 = 92$ 个苹果。", "\\end{solution}", "", "\\begin{solution}{exo:g3:problems:7}", "科学书：$6 + 8 = 14$ 本。小说：$12 - 9 = 3$，第二周多 3 本。", "\\end{solution}", "", "\\begin{solution}{exo:g3:problems:8}", "周一 $12$，周二 $20$，周三 $12$，合计", "$12 + 20 + 12 = 44$ 个蛋糕。销量最好的是周二。", "\\end{solution}", "", "\\begin{solution}{exo:g3:problems:9}", "无用的数据是价格（$12$）。除法：", "$210 \\div 35 = 6$（因为 $35 \\times 6 = 210$）。里奥需要 $6$ 天。", "\\end{solution}", "", "\\begin{solution}{exo:g3:problems:10}", "成人：$2 \\times 9 = 18$。儿童：$3 \\times 4 = 12$。总价：", "$18 + 12 = 30$。找零：$50 - 30 = 20$。他们应找回 $20$。", "\\end{solution}", "", "\\begin{solution}{exo:g3:problems:11}", "答案不唯一 --- 例如：“一位花商扎了 $8$ 束", "每束 $15$ 朵花，然后拿走 $20$ 朵枯萎的花。", "还剩多少朵花？”解：$8 \\times 15 = 120$，再 $120 - 20 = 100$。", "\\end{solution}", ""]}