{"sha": "f964cda31523815f51cf208a80aea03fe4d203c9079ffe6aa04edfa115dccb83", "body": ["\\section*{第 \\ref{ch:g8:fractions} 章 --- 分数的四则运算}", "", "\\begin{solution}{exo:g8:fractions:1}", "$\\dfrac34 + \\dfrac25 = \\dfrac{15}{20} + \\dfrac{8}{20} =", "\\dfrac{23}{20}$.", "", "$\\dfrac56 - \\dfrac38 = \\dfrac{20}{24} - \\dfrac{9}{24} =", "\\dfrac{11}{24}$.", "", "$\\dfrac{7}{10} + \\dfrac{8}{15} = \\dfrac{21}{30} + \\dfrac{16}{30} =", "\\dfrac{37}{30}$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:2}", "$-\\dfrac27 + \\dfrac{3}{14} = -\\dfrac{4}{14} + \\dfrac{3}{14} =", "-\\dfrac{1}{14}$.", "", "$\\dfrac16 - \\dfrac54 = \\dfrac{2}{12} - \\dfrac{15}{12} =", "-\\dfrac{13}{12}$.", "", "$-\\dfrac35 - \\dfrac12 = -\\dfrac{6}{10} - \\dfrac{5}{10} =", "-\\dfrac{11}{10}$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:3}", "$\\dfrac58 \\times \\dfrac{4}{15} = \\dfrac{5 \\times 4}{8 \\times 15}", "= \\dfrac{1}{2 \\times 3} = \\dfrac16$（约去 $5$ 与 $4$）。", "", "$\\dfrac{9}{14} \\times \\dfrac73 = \\dfrac{9 \\times 7}{14 \\times 3}", "= \\dfrac{3}{2}$（约去 $7$ 与 $3$）。", "", "$\\left(-\\dfrac65\\right) \\times \\dfrac{10}{9} = -\\dfrac{60}{45}", "= -\\dfrac43$（异号，结果为负）。", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:4}", "倒数：$\\dfrac73$；\\quad $\\dfrac15$；\\quad $4$；\\quad", "$-\\dfrac92$（倒数保持原数的符号）。", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:5}", "$\\dfrac49 \\div \\dfrac23 = \\dfrac49 \\times \\dfrac32 = \\dfrac{12}{18}", "= \\dfrac23$.", "", "$\\dfrac75 \\div 14 = \\dfrac75 \\times \\dfrac{1}{14} = \\dfrac{7}{70}", "= \\dfrac{1}{10}$.", "", "$6 \\div \\dfrac34 = 6 \\times \\dfrac43 = 8$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:6}", "$\\dfrac{3/4}{9/8} = \\dfrac34 \\times \\dfrac89 = \\dfrac{24}{36} =", "\\dfrac23$.", "", "$\\dfrac{5/6}{10} = \\dfrac56 \\times \\dfrac{1}{10} = \\dfrac{5}{60} =", "\\dfrac{1}{12}$.", "", "$\\dfrac{2}{4/7} = 2 \\times \\dfrac74 = \\dfrac72$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:7}", "先计算乘法：", "$\\dfrac13 + \\dfrac12 \\times \\dfrac45 = \\dfrac13 + \\dfrac{4}{10}", "= \\dfrac{10}{30} + \\dfrac{12}{30} = \\dfrac{22}{30} = \\dfrac{11}{15}$.", "", "先计算括号：", "$\\left(\\dfrac13 + \\dfrac12\\right) \\times \\dfrac45", "= \\dfrac56 \\times \\dfrac45 = \\dfrac{20}{30} = \\dfrac23$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:8}", "已装部分：$\\dfrac25 + \\dfrac13 = \\dfrac{6}{15} + \\dfrac{5}{15} =", "\\dfrac{11}{15}$（占整个水箱）。空的部分：", "$1 - \\dfrac{11}{15} = \\dfrac{4}{15}$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:9}", "人数多于 $14$ 时的分数：", "$\\dfrac23 \\times \\dfrac34 = \\dfrac{6}{12} = \\dfrac12$，即全班人数的一半。", "若这部分为 $12$ 人，则全班有 $24$ 人。", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:10}", "$\\dfrac{15}{2} \\div \\dfrac34 = \\dfrac{15}{2} \\times \\dfrac43", "= \\dfrac{60}{6} = 10$ 段 --- 结果为整数，绳子没有剩余。", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:11}", "$E$：先计算除法：", "$\\dfrac56 \\div \\dfrac{10}{9} = \\dfrac56 \\times \\dfrac{9}{10}", "= \\dfrac{45}{60} = \\dfrac34$；然后", "$E = \\dfrac23 - \\dfrac34 = \\dfrac{8}{12} - \\dfrac{9}{12} =", "-\\dfrac{1}{12}$.", "", "$F = \\left(-\\dfrac12\\right)^2 \\times \\dfrac83 = \\dfrac14 \\times", "\\dfrac83 = \\dfrac{8}{12} = \\dfrac23$（平方结果为正）。", "\\end{solution}", "", "\\begin{solution}{exo:g8:fractions:12}", "由内向外计算：$1 + 1 = 2$；然后", "$1 + \\dfrac12 = \\dfrac32$；然后", "\\[", "1 + \\frac{1}{3/2} = 1 + \\frac23 = \\frac53 .", "\\]", "\\end{solution}", "", "\\begin{solution}{pb:g8:fractions:1}", "\\textbf{1.} $\\frac12 + \\frac13 = \\frac36 + \\frac26 = \\frac56$ 且", "$\\frac12 + \\frac14 = \\frac24 + \\frac14 = \\frac34$。因此", "$\\frac56 = \\frac12 + \\frac13$ 与 $\\frac34 = \\frac12 + \\frac14$", "都是埃及分数（每式中的分数均为互不相同的单位分数）。", ""]}