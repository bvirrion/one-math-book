{"sha": "d132056deff056b08be3890c7a41702069ce7b1b3756551778c875c428ef191c", "body": ["\\begin{exercise}[$\\star$]\\label{exo:g8:equations:5}", "解下列方程：", "\\[", "6x + 5 = 2x + 25, \\qquad", "9 - 4x = x - 11, \\qquad", "3(x + 2) = 2x + 11 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g8:equations:6}", "解方程 $4(2x - 3) = 5(x + 6)$，先展开再求解，", "并检验你的解。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g8:equations:7}", "列出方程并求解：“一个数的三倍减去 $8$ 等于", "$19$”；“一个数的两倍增加 $5$ 后，等于这个数增加", "$12$”。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g8:equations:8}", "一个长方形的长比宽多 $5$ cm，其周长为", "$58$ cm。设 $x$ 为宽，列出方程并求解，", "并求出长和宽。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g8:equations:9}", "三个连续整数的和为 $141$。记中间的数为", "$n$，求出这三个数。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g8:equations:10}", "解下列不等式，并描述其解集：", "\\[", "3x + 4 > 19, \\qquad", "7 - 2x \\geq 1, \\qquad", "5(x - 1) < 2x + 7 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g8:equations:11}", "米娅有存款 $140$ 欧元，每月增加 $15$ 欧元；汤姆", "有 $200$ 欧元，每月增加 $10$ 欧元。经过几个月后，", "米娅的存款严格多于汤姆的存款？（列出不等式。）", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star\\star$]\\label{exo:g8:equations:12}", "解方程 $\\dfrac{x + 3}{4} = \\dfrac{2x - 1}{5}$。", "（两边同乘公分母 $20$，再按常规方法求解；", "并把解代入原方程检验。）", "\\end{exercise}", "", "\\section{问题：乘法公式与", "奇数的阶梯}", "", "\\begin{problem}[{周末问题 --- $(a+b)^2$, $(a-b)^2$,", "$(a+b)(a-b)$，以及奇数求和 $1 + 3 + 5 + \\dots + (2n-1) = n^2$}]", "\\label{pb:g8:equations:1}", "三个展开式十分常用，代数中人们把它们", "熟记于心，它们被称为\\emph{乘法公式}。本题", "由双重分配律推出它们，", "（见\\cref{thm:g8:equations:expand}），将它们变成心算的", "超能力，用它们证明一个关于奇数的漂亮事实，", "最后求解一类全新的方程：", "含平方项的方程。", "", "\\medskip", "\\noindent\\textbf{第一部分 --- 三个乘法公式。}", "\\begin{enumerate}", "  \\item 展开 $(a + b)^2 = (a + b)(a + b)$ 并化简，证明", "        \\[", "        (a + b)^2 = a^2 + 2ab + b^2 .", "        \\]", "  \\item 类似地证明另外两个公式：", "        \\[", "        (a - b)^2 = a^2 - 2ab + b^2,", "        \\qquad", "        (a + b)(a - b) = a^2 - b^2 .", "        \\]", "  \\item 画一个边长为 $a + b$ 的正方形，将每条边分为 $a$", "        和 $b$ 两段，并将正方形切成四块。", "        图中各部分分别对应", "        第一个公式中的哪一项？", "  \\item 心算：利用这些公式计算，", "        不列出任何乘法算式，求下列各式的值：", "        \\[", "        101^2, \\qquad 99^2, \\qquad 49 \\times 51 .", "        \\]", "  \\item 一个经典陷阱：佐伊写出“$(a + b)^2 = a^2 + b^2$”。", "        取 $a = 3$，$b = 4$ 检验她的公式，并在", "        第 3 小题的图上说明，她的公式", "        遗漏了哪些部分。", "\\end{enumerate}", "", "\\medskip", "\\noindent\\textbf{第二部分 --- 奇数的阶梯。}", "\\begin{enumerate}[resume]", "  \\item 依次计算 $1$、$1 + 3$、$1 + 3 + 5$，接着", "        $1 + 3 + 5 + 7$，再算 $1 + 3 + 5 + 7 + 9$。你发现", "        这些结果有什么规律？", "  \\item 说明为什么第 $n$ 个奇数是 $2n - 1$（检验：", "        $n = 1, 2, 3$ 分别给出 $1, 3, 5$）。", "  \\item 利用第一部分中的一个公式展开并化简", "        $(n + 1)^2 - n^2$。这个结果与", "        第 7 小题有什么关系？", "  \\item 第 8 小题指出：要从边长为 $n$ 的正方形", "        变为边长为 $n + 1$ 的正方形，恰好需要添加下一个奇数", "        个单位方格，即沿两条边加一个 L 形的框，", "        再加上拐角处的方格。从 $1 = 1^2$ 出发，逐层", "        扩大正方形，解释为什么", "        \\[", "        1 + 3 + 5 + \\dots + (2n - 1) = n^2 :", "        \\]", "        即前 $n$ 个奇数之和是第 $n$ 个平方数。", "  \\item 不必逐个相加，推出：", "        $1 + 3 + 5 + \\dots + 99$ 的值；以及从 $1$ 开始，", "        需要取多少个奇数相加，和恰好为 $400$？", "\\end{enumerate}", "", "\\medskip", "\\noindent\\textbf{第三部分 --- 含平方的方程。}", "\\begin{enumerate}[resume]", "  \\item 识别 $x^2 + 6x + 9$ 中的一个乘法公式，并", "        解方程 $x^2 + 6x + 9 = 0$。", "  \\item 借助 \\cref{thm:g8:negprod:rules}", "        中的符号与绝对值规则，说明为什么两个数之积", "        \\emph{只有当}其中一个因式为零时，积才可能为零。", "        利用这一结论解方程 $(x - 2)(x + 5) = 0$。", "  \\item 解方程 $x^2 = 49$：把所有项移到一边，", "        再用第三个公式分解 $x^2 - 49$。这个方程有几个解？", "        它与本章到目前为止所解的每个方程有何", "        不同？", "  \\item 在\\cref{exo:g8:equations:3}中你验证过 $x = 3$ 是", "        方程 $x^2 = 6x - 9$ 的解。现证明它是", "        \\emph{唯一}的解：把各项移到一边，识别", "        一个乘法公式，并作出结论。", "  \\item 压轴：心算 $2026^2 - 2025^2$，并", "        利用乘法公式说明为什么两个相邻平方数之差", "        总是这两个数的和", "        --- 正是第 8 小题的内容。", "\\end{enumerate}", "\\end{problem}", ""]}