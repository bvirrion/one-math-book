{"sha": "9d0e474ab545d67a0de3541027e3761c0ea158c40ce5c2d38de05267695a1ba1", "body": ["\\section*{第 \\ref{ch:g8:powers} 章 --- 幂}", "", "\\begin{solution}{exo:g8:powers:1}", "$2^6 = 64$; \\quad $3^3 = 27$; \\quad $10^5 = 100\\,000$; \\quad", "$1^{100} = 1$; \\quad $0.1^2 = 0.01$; \\quad $6^0 = 1$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:powers:2}", "$(-3)^2 = 9$; \\quad $-3^2 = -9$; \\quad $(-1)^{15} = -1$; \\quad", "$(-5)^3 = -125$; \\quad $\\left(\\frac23\\right)^2 = \\frac49$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:powers:3}", "$7^4 \\times 7^5 = 7^9$; \\quad", "$\\dfrac{2^9}{2^3} = 2^6$; \\quad", "$\\left(10^3\\right)^4 = 10^{12}$; \\quad", "$5^6 \\times 5^{-2} = 5^4$; \\quad", "$3^4 \\times 7^4 = 21^4$（指数相同，底数相乘）。", "\\end{solution}", "", "\\begin{solution}{exo:g8:powers:4}", "$10^{-2} = 0.01$; \\quad", "$4 \\times 10^3 = 4000$; \\quad", "$2.5 \\times 10^{-4} = 0.00025$; \\quad", "$10^0 = 1$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:powers:5}", "$10^5$; \\quad $10^{-1}$; \\quad $10^{10}$; \\quad $10^{-6}$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:powers:6}", "$\\dfrac{10^7 \\times 10^{-3}}{10^2} = \\dfrac{10^4}{10^2} = 10^2 =", "100$.", "", "$\\dfrac{2^5 \\times 2^4}{2^6} = \\dfrac{2^9}{2^6} = 2^3 = 8$.", "", "$\\left(2^2\\right)^3 \\times 2^{-4} = 2^6 \\times 2^{-4} = 2^2 = 4$.", "\\end{solution}", "", "\\begin{solution}{exo:g8:powers:7}", "$2^3 \\times 2^4 = 2^{12}$：\\emph{错误} --- 指数相加：", "$2^7$.", "", "$5^2 + 5^3 = 5^5$：\\emph{错误} --- 和式没有对应的法则：", "$25 + 125 = 150$，而 $5^5 = 3125$。", "", "$(3^2)^4 = 3^8$：\\emph{正确}。", "", "$10^3 \\times 10^3 = 100^3$：\\emph{正确} --- 两者都等于 $10^6$", "（左边：$10^{3+3}$；右边：$(10^2)^3$）。", "\\end{solution}", "", "\\begin{solution}{exo:g8:powers:8}", "第 $4$ 天新增的人：第 3 天得知消息的 $3^3 = 27$ 人，", "每人再告知三人，即新增 $3^4 = 81$ 人。截至第 4 天结束，知道消息的人共", "$3 + 9 + 27 + 81 = 120$ 人。", "\\end{solution}", "", "\\begin{solution}{exo:g8:powers:9}", "\\emph{1.} 厚度：$2^{10} \\times 10^{-4}$ m", "$= 1024 \\times 10^{-4}$ m $\\approx 0.1$ m $= 10$ cm.", "", "\\emph{2.} $2^{42} \\times 10^{-4} \\approx 4.4 \\times 10^{12} \\times", "10^{-4} = 4.4 \\times 10^8$ m，大于 $3.8 \\times 10^8$ m。经过", "$42$ 次（纯属理论！）折叠，这叠纸就会超过月球。", "\\end{solution}", "", "\\begin{solution}{exo:g8:powers:10}", "$2^{10} = 1024$；$10^3 = 1000$；$3^6 = 729$；$5^4 = 625$。从小到大排列为：", "\\[", "5^4 < 3^6 < 10^3 < 2^{10} .", "\\]", "\\end{solution}", "", "\\begin{solution}{exo:g8:powers:11}", "$2^{100} = \\left(2^{10}\\right)^{10} = 1024^{10}$，而", "$10^{30} = \\left(10^3\\right)^{10} = 1000^{10}$。因为 $1024 > 1000$，", "两边各取十次幂，不等号方向保持不变：", "$2^{100} > 10^{30}$.", "\\end{solution}", "", "\\begin{solution}{pb:g8:powers:1}", "\\textbf{1.} 麦粒逐格翻倍，首格为", "$1 = 2^0$ 粒：第 $k$ 格放 $2^{k-1}$ 粒", "（见\\cref{def:g8:powers:def}）。第 $64$ 格放 $2^{63}$ 粒。", "", "\\textbf{2.} $S_1 = 1$，$S_2 = 1 + 2 = 3$，$S_3 = 3 + 4 = 7$，", "$S_4 = 7 + 8 = 15$，$S_5 = 15 + 16 = 31$：总比", "下一个 $2$ 的幂小 1（$2$、$4$、$8$、$16$、$32$）。猜想：", "$S_n = 2^n - 1$.", "", "\\textbf{3.} 将 $S_n$ 的每一项都乘以 2，每个幂的指数都增加", "1（$2 \\times 2^{k} = 2^{k+1}$）：", "\\begin{align*}", "S_n &= 1 + 2 + 4 + \\dots + 2^{n-1}, \\\\", "2 \\times S_n &= \\phantom{1 + {}} 2 + 4 + \\dots + 2^{n-1} + 2^n .", "\\end{align*}", "将第二式减去第一式，从 $2$", "到 $2^{n-1}$ 的每一项在两式中都出现，全部相消：", "\\[", "2 \\times S_n - S_n = 2^n - 1,", "\\qquad\\text{即}\\qquad", "S_n = 2^n - 1 .", "\\]", "", "\\textbf{4.} 棋盘上麦粒的总数为 $S_{64} = 2^{64} - 1$ 粒。", "设想第 65 格放 $2^{64}$ 粒，则整个棋盘", "的粒数比那一格所应放的恰好少 1 粒。", ""]}