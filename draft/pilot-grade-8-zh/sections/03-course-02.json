{"sha": "2a77ee3771f5a5644c2c3a0a73b0b4a14743a7c266c68903191fbfc5583764a8", "body": ["\\begin{example}[数量级]\\label{ex:g8:powers:magnitude}", "光速约为 $3 \\times 10^8$ m/s；一年约有", "$3.2 \\times 10^7$ 秒。因此一光年约为", "\\[", "3 \\times 3.2 \\times 10^{8+7} \\approx 10 \\times 10^{15} = 10^{16}", "\\text{ m}", "\\]", "--- 即一亿亿米。借助十的幂，天文计算", "可以写在一行之内。", "\\end{example}", "", "\\begin{method}[化简含幂的表达式]\\label{met:g8:powers:simplify}", "\\begin{enumerate}", "  \\item 按底数归并各因式；", "  \\item 对每个底数应用指数运算法则；", "  \\item 计算其余较小的幂，若结果较大，则保留", "        为幂的形式。", "\\end{enumerate}", "\\end{method}", "", "\\begin{example}\\label{ex:g8:powers:simplify}", "\\[", "\\frac{3^5 \\times 3^{-2} \\times 4^2}{3^2}", "= \\frac{3^{5 + (-2)}}{3^2} \\times 16", "= 3^{3 - 2} \\times 16", "= 3 \\times 16 = 48 .", "\\]", "\\end{example}", "", "\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g8:powers:1}", "计算：", "\\[", "2^6, \\qquad 3^3, \\qquad 10^5, \\qquad 1^{100}, \\qquad 0.1^2, \\qquad", "6^0 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g8:powers:2}", "计算：", "\\[", "(-3)^2, \\qquad -3^2, \\qquad (-1)^{15}, \\qquad (-5)^3, \\qquad", "\\left(\\tfrac{2}{3}\\right)^2 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g8:powers:3}", "将下列各式写成一个幂：", "\\[", "7^4 \\times 7^5, \\qquad", "\\frac{2^9}{2^3}, \\qquad", "\\left(10^3\\right)^4, \\qquad", "5^6 \\times 5^{-2}, \\qquad", "3^4 \\times 7^4 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g8:powers:4}", "写成小数：$10^{-2}$；\\quad $4 \\times 10^3$；\\quad", "$2.5 \\times 10^{-4}$; \\quad $10^0$.", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g8:powers:5}", "写成十的幂的形式：十万；十分之一；一", "百亿；$0.000\\,001$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g8:powers:6}", "化简后计算：", "\\[", "\\frac{10^7 \\times 10^{-3}}{10^2},", "\\qquad", "\\frac{2^5 \\times 2^4}{2^6},", "\\qquad", "\\left(2^2\\right)^3 \\times 2^{-4} .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g8:powers:7}", "判断下列各式是否正确？并改正错误的式子。", "\\[", "2^3 \\times 2^4 = 2^{12}; \\qquad", "5^2 + 5^3 = 5^5; \\qquad", "(3^2)^4 = 3^8; \\qquad", "10^3 \\times 10^3 = 100^3 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g8:powers:8}", "一则谣言传播：第 1 天有 3 人知道；每天，每个", "知道的人每人再告诉 3 个新的人。用幂表示", "第 $4$ 天被告知的\\emph{新}人数，并求", "出第 4 天结束时知道谣言的人数（包括最初的 3 人）。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g8:powers:9}", "一张纸厚 $0.1$ mm，即 $10^{-4}$ m。每折一次，", "厚度便加倍。", "\\begin{enumerate}", "  \\item 将折叠 $10$ 次后的厚度写成乘积形式，并", "        以厘米为单位计算该厚度（$2^{10} = 1024$）。", "  \\item 折叠 $42$ 次后，厚度为", "        $2^{42} \\times 10^{-4}$ m，其中 $2^{42} \\approx 4.4 \\times", "        10^{12}$。证明该厚度超过地月距离，", "        约为 $3.8 \\times 10^8$ m。", "\\end{enumerate}", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g8:powers:10}", "不用计算器，按从小到大的顺序排列：", "\\[", "2^{10}, \\qquad 10^3, \\qquad 3^6, \\qquad 5^4 .", "\\]", "（逐一计算；$2^{10}$ 与 $10^3$ 是著名的“近邻”。）", "\\end{exercise}", ""]}