{"sha": "98ef56e9580b4b0fcac72de79264f21871b4d9ded2f6f424a2ba14ee7c7b2528", "body": ["\\section*{第 \\ref{ch:g11:scal} 章 --- 平面上的数量积}", "", "\\begin{solution}{exo:g11:scal:1}", "$(2,5)\\cdot(3,-1) = 6 - 5 = 1$.", "", "$(1,-4)\\cdot(8,2) = 8 - 8 = 0$（正交向量）。", "", "$\\vec u\\cdot\\vec v = 3 \\times 4 \\times \\cos\\frac\\pi3 = 12 \\times \\frac12", "= 6$.", "\\end{solution}", "", "\\begin{solution}{exo:g11:scal:2}", "$\\vect{AB}\\cdot\\vect{AC} = 6 \\times 6 \\times \\cos 60^\\circ = 18$.", "", "向量 $\\vect{AB}$ 与 $\\vect{BC}$ 的夹角为", "$180^\\circ - 60^\\circ = 120^\\circ$（将二者起点置于 $B$ 处），于是", "$\\vect{AB}\\cdot\\vect{BC} = 36 \\cos 120^\\circ = -18$.", "\\end{solution}", "", "\\begin{solution}{exo:g11:scal:3}", "$\\vec u \\cdot \\vec v = 3(t - 8) + t = 4t - 24 = 0$ 得 $t = 6$。", "", "$\\vec u - \\vec v = (t - 4,\\ 0)$，于是", "$\\vec u \\cdot (\\vec u - \\vec v) = t(t-4) + 0 = t^2 - 4t$，它在", "$t = 0$ 或 $t = 4$ 时为零。", "\\end{solution}", "", "\\begin{solution}{exo:g11:scal:4}", "$\\vec u \\cdot \\vec v = 3 + 2 = 5$, $\\norm{\\vec u} = \\sqrt5$,", "$\\norm{\\vec v} = \\sqrt{10}$，于是", "\\[", "\\cos\\theta = \\frac{5}{\\sqrt5\\,\\sqrt{10}} = \\frac{5}{5\\sqrt2}", "= \\frac{\\sqrt2}{2},", "\\]", "因此恰有 $\\theta = 45^\\circ$。", "\\end{solution}", "", "\\begin{solution}{exo:g11:scal:5}", "$a^2 = 16 + 36 - 2 \\times 4 \\times 6 \\times \\cos\\frac{2\\pi}{3}", "= 52 - 48 \\times \\left(-\\frac12\\right) = 76$，于是 $a = \\sqrt{76} =", "2\\sqrt{19} \\approx 8.7$.", "", "对于第二个三角形，由余弦定理解出角的余弦，得", "\\[", "\\cos\\widehat A = \\frac{b^2 + c^2 - a^2}{2bc}", "= \\frac{25 + 16 - 49}{2 \\times 5 \\times 4} = -\\frac{8}{40} = -\\frac15,", "\\]", "负值，故 $\\widehat A$ 为钝角。", "\\end{solution}", "", "\\begin{solution}{exo:g11:scal:6}", "$\\vect{AB}\\,(4, -2)$ 与 $\\vect{AC}\\,(2, 4)$：", "$\\vect{AB}\\cdot\\vect{AC} = 8 - 8 = 0$，于是 $A$ 处的角为直角。", "各边长：$AB = \\sqrt{16 + 4} = \\sqrt{20}$，$AC = \\sqrt{4 + 16} =", "\\sqrt{20}$，又 $\\vect{BC}\\,(-2, 6)$ 得 $BC = \\sqrt{40}$。验证：", "$BC^2 = 40 = 20 + 20 = AB^2 + AC^2$，此即余弦定理", "在 $\\cos\\widehat A = 0$ 时的情形（毕达哥拉斯定理）。", "\\end{solution}", "", "\\begin{solution}{exo:g11:scal:7}", "圆心--半径式：$(x + 2)^2 + (y - 3)^2 = 25$。", "", "对于第二个圆，配方：", "\\[", "x^2 - 6x + y^2 + 2y = 6", "\\iff (x - 3)^2 - 9 + (y + 1)^2 - 1 = 6", "\\iff (x-3)^2 + (y+1)^2 = 16 :", "\\]", "圆心 $(3, -1)$，半径 $4$。", "\\end{solution}", "", "\\begin{solution}{exo:g11:scal:8}", "$M(x,y)$ 在圆上当且仅当 $\\vect{MA}\\cdot\\vect{MB} = 0$，其中", "$\\vect{MA}\\,(-3 - x,\\ -y)$ 与 $\\vect{MB}\\,(-x,\\ 2 - y)$：", "\\[", "(-3 - x)(-x) + (-y)(2 - y) = x^2 + 3x + y^2 - 2y = 0 .", "\\]", "对于原点：$0 + 0 + 0 - 0 = 0$，故 $O$ 在圆上 ---", "从几何上看，$\\vect{OA}\\,(-3,0)$ 与 $\\vect{OB}\\,(0,2)$ 正交，", "于是从 $O$ 看线段 $[AB]$ 的张角为直角。（配方后：", "圆心 $\\left(-\\frac32, 1\\right)$，半径 $\\frac{\\sqrt{13}}{2}$。）", "\\end{solution}", "", "\\begin{solution}{exo:g11:scal:9}", "过 $P$ 的垂线的法向量取 $d$ 的方向向量，", "即 $(-1, 2)$，故方程为 $-x + 2y + c = 0$；过", "$P(1,3)$ 得 $-1 + 6 + c = 0$，$c = -5$，于是 $x - 2y + 5 = 0$。", "", "与 $d$ 的交点：由 $2x + y = 7$ 得 $y = 7 - 2x$；代入，", "$x - 2(7 - 2x) + 5 = 5x - 9 = 0$，于是 $x = \\frac95$，$y = \\frac{17}5$：", "$H\\left(\\frac95, \\frac{17}5\\right)$。于是", "$\\vect{PH}\\left(\\frac45, \\frac25\\right)$，且", "\\[", "PH = \\sqrt{\\frac{16}{25} + \\frac{4}{25}} = \\frac{\\sqrt{20}}{5}", "= \\frac{2\\sqrt5}{5} \\approx 0.89 .", "\\]", "\\end{solution}", "", "\\begin{solution}{exo:g11:scal:10}", "相加得", "\\[", "\\norm{\\vec u + \\vec v}^2 = \\norm{\\vec u}^2 + 2\\vec u\\cdot\\vec v +", "\\norm{\\vec v}^2", "\\quad\\text{和}\\quad", "\\norm{\\vec u - \\vec v}^2 = \\norm{\\vec u}^2 - 2\\vec u\\cdot\\vec v +", "\\norm{\\vec v}^2,", "\\]", "交叉项相消，于是", "$\\norm{\\vec u + \\vec v}^2 + \\norm{\\vec u - \\vec v}^2 = 2\\norm{\\vec u}^2 +", "2\\norm{\\vec v}^2$。在以 $\\vec u$ 与 $\\vec v$ 为边的平行四边形中，", "其对角线为 $\\vec u + \\vec v$ 与 $\\vec u - \\vec v$，两条对角线的", "平方和等于四条边的", "平方和。", "\\end{solution}", ""]}