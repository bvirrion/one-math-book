{"sha": "1cb12f2a9f533c7d5854b5fc3e6b8c630be2a8c36f12106569d6ed3730a6ca2b", "body": ["\\section{除法}", "", "\\begin{theorem}[带余除法]\\label{thm:g6:wholes:division}", "给定两个整数 $a$（\\emph{被除数}）和 $b \\neq 0$（", "\\emph{除数}），有且仅有一种方式将其写成", "\\[", "a = b \\times q + r", "\\qquad\\text{其中}\\qquad", "0 \\leq r < b .", "\\]", "$q$ 称为\\emph{商}\\index{商}，$r$ 称为", "\\emph{余数}\\index{余数}，它们是 $a$ 除以 $b$ 所得的结果。", "\\end{theorem}", "\\admitted", "", "\\begin{example}\\label{ex:g6:wholes:division}", "逐步计算 $137$ 除以 $4$。", "\\begin{enumerate}", "  \\item $4$ 在 $13$ 里包含几次？答：3 次", "        （$4 \\times 3 = 12$），余数 $13 - 12 = 1$。", "  \\item 落下 $7$，$4$ 在 $17$ 里包含几次？", "        答：4 次（$4 \\times 4 = 16$），余数 $1$。", "\\end{enumerate}", "于是 $q = 34$，$r = 1$：", "\\[", "137 = 4 \\times 34 + 1, \\qquad\\text{且显然 } 0 \\leq 1 < 4 .", "\\]", "验算：$4 \\times 34 = 136$，且 $136 + 1 = 137$。", "\\end{example}", "", "\\begin{omfigure}", "\\begin{tikzpicture}[scale=0.95]", "  \\draw[-Stealth] (-0.3,0) -- (11.2,0);", "  \\foreach \\i in {0,1,...,34} \\draw ({\\i*0.32},-0.06) -- ({\\i*0.32},0.06);", "  \\foreach \\i in {0,10,20,30}", "    \\node[below, font=\\footnotesize] at ({\\i*0.32},-0.08) {$4\\times\\i$};", "  \\draw[omDef, very thick] (0,0.14) -- (10.88,0.14);", "  \\draw[omThm, very thick] (10.88,0.14) -- (10.96,0.14);", "  \\fill (10.96,0) circle (1.8pt) node[above, font=\\small] {$137$};", "  \\node[omDef, font=\\small] at (5.4,0.55) {$34$ 组，每组 $4$ 个};", "\\end{tikzpicture}", "", "{\\small 计算 $137$ 除以 $4$：可以装满 $34$ 组，每组 $4$ 个", "（共 $136$），还剩 $1$ --- 余数总是", "比除数小。}", "\\end{omfigure}", "", "\\begin{definition}[能被……整除]\\label{def:g6:wholes:divisible}", "当余数为 $0$ 时，称 $a$ 能被 $b$", "\\emph{整除}\\index{整除}：例如 $135$ 能被 $5$ 整除，", "因为 $135 = 5 \\times 27 + 0$。", "\\end{definition}", "", "\\begin{method}[含除法的应用题]\\label{met:g6:wholes:problems}", "算出 $a = bq + r$ 后，务必回到题目所问：", "\\begin{enumerate}", "  \\item “能装满几箱/几队/几页？” --- 答案是", "        商 $q$；", "  \\item “还剩几个？” --- 答案是", "        余数 $r$；", "  \\item “所有人需要几箱？” --- 若 $r > 0$，则需要", "        比商\\emph{多}一箱，即 $q + 1$。", "\\end{enumerate}", "\\end{method}", "", "\\begin{example}\\label{ex:g6:wholes:bus}", "$137$ 名学生乘坐每车 $40$ 个座位的客车外出，列除法算式：", "$137 = 40 \\times 3 + 17$。3 辆客车可载 $120$ 名学生，剩下 $17$", "名学生 --- 他们也需要一辆车！所以需要 $4$ 辆客车，", "尽管商是 $3$。", "\\end{example}", "", "\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g6:wholes:1}", "用数字写出：“三千零四十七”；“二万", "零五百”；“一百零四”。再用汉字写出 $60\\,013$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g6:wholes:2}", "在数 $47\\,209$ 中：百位上的数字是几？个位", "上的数字是几？数字 $4$ 表示多少个什么？", "把该数写成 $1$、$10$、$100$、\\dots\\ 的倍数之和，仿照", "\\cref{def:g6:wholes:place}。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g6:wholes:3}", "抄写下列各式，并在空处填入 $<$ 或 $>$：", "\\[", "507 \\;?\\; 570, \\qquad", "1\\,099 \\;?\\; 989, \\qquad", "23\\,456 \\;?\\; 23\\,465, \\qquad", "9\\,999 \\;?\\; 10\\,000 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g6:wholes:4}", "将下列各数从小到大排列：$2\\,043$；$978$；$2\\,304$；$2\\,034$；", "$1\\,001$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g6:wholes:5}", "用竖式计算：$348 + 576$；\\quad $805 - 268$；\\quad", "$307 \\times 26$。用加法检验减法的结果。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g6:wholes:6}", "运用巧算，将加数或因数适当分组后计算：", "\\[", "38 + 45 + 12 + 5, \\qquad", "2 \\times 83 \\times 50, \\qquad", "4 \\times 78 \\times 25 .", "\\]", "\\end{exercise}", ""]}