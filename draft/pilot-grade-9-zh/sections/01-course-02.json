{"sha": "fb31d3365d6fe34c44b035f612863f3feb4de2987818416e02d47f576c6c7e6d", "body": ["\\begin{example}", "$2^4 = 2 \\times 2 \\times 2 \\times 2 = 16$; \\quad", "$(-3)^2 = 9$ 而 $-3^2 = -(3^2) = -9$（指数的运算先于", "负号）；\\quad $10^{-3} = \\frac{1}{1000} = 0.001$； \\quad", "$5^1 = 5$ 和 $5^0 = 1$。", "\\end{example}", "", "\\begin{theorem}[指数运算法则]\\label{thm:g9:fractions:rules}", "对任意非零的 $a$、$b$ 及所有整数 $m$、$n$：", "\\[", "a^m \\times a^n = a^{m+n},", "\\qquad", "\\frac{a^m}{a^n} = a^{m-n},", "\\qquad", "\\left(a^m\\right)^n = a^{mn},", "\\qquad", "(ab)^n = a^n b^n .", "\\]", "\\end{theorem}", "", "\\begin{proof}", "正指数的情形，数一数因数的个数。对于第一条法则：", "$a^m \\times a^n$ 是 $m$ 个因数 $a$ 后接 $n$ 个因数 $a$，共", "$m + n$ 个因数。对于第三条：", "$\\left(a^m\\right)^n$ 表示 $n$ 组各含 $m$ 个因数的积，得到", "$mn$ 个因数。其余两条法则类似；零指数与负指数的情形", "由 $a^{-n} = \\frac{1}{a^n}$ 检验（并使", "约定 $a^0 = 1$ 成为唯一相容的选择，因为", "$a^n \\times a^0$ 必须等于 $a^{n+0} = a^n$）。", "\\end{proof}", "", "\\begin{example}\\label{ex:g9:fractions:rules}", "逐步化简：", "\\[", "\\frac{3^7 \\times 3^{-2}}{3^4}", "= \\frac{3^{7 + (-2)}}{3^4}", "= \\frac{3^5}{3^4}", "= 3^{5-4} = 3^1 = 3 .", "\\]", "再看含字母的情形：$(2a^3)^2 \\times a = 4 a^6 \\times a = 4a^7$。", "\\end{example}", "", "\\section{十的幂与科学记数法}", "", "\\begin{proposition}[十的幂]\\label{prop:g9:fractions:ten}", "对正整数 $n$，$10^n$ 写作“$1$ 后接 $n$", "个零”，且 $10^{-n} = 0.0\\dots01$ 中的 $1$ 位于小数点后第 $n$", "位。小数乘以 $10^n$（或 $10^{-n}$）时，其小数点", "向右（或向左）移动 $n$ 位。", "\\end{proposition}", "", "\\begin{definition}[科学记数法]\\label{def:g9:fractions:scientific}", "正小数的\\emph{科学记数法}\\index{科学记数法}", "是将其唯一地写成下列形式：", "\\[", "a \\times 10^n,", "\\qquad\\text{其中 } 1 \\leq a < 10 \\text{ 且 } n \\text{ 为整数。}", "\\]", "\\end{definition}", "", "\\begin{example}\\label{ex:g9:fractions:scientific}", "地球与太阳的距离约为 $149\\,600\\,000$ km $= 1.496 \\times", "10^8$ km。一个水分子的大小约为 $0.000\\,000\\,000\\,28$ m", "$= 2.8 \\times 10^{-10}$ m。计算这类数时，", "分别结合小数部分与十的幂：", "\\[", "(3 \\times 10^5) \\times (2.5 \\times 10^{-2})", "= (3 \\times 2.5) \\times 10^{5 + (-2)}", "= 7.5 \\times 10^{3}.", "\\]", "\\end{example}", "", "\\begin{method}[将数写成科学记数法]\\label{met:g9:fractions:scientific}", "\\begin{enumerate}", "  \\item 将小数点移到第一个非零数字之后，这样", "        便得到因数 $a$，满足 $1 \\leq a < 10$；", "  \\item 数出小数点移动的位数，这个位数即为 $n$，", "        原数 $\\geq 10$ 时取正，原数", "        $< 1$ 时取负；", "  \\item 检验：$a \\times 10^n$ 须还原原数。", "\\end{enumerate}", "\\end{method}", "", "\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g9:fractions:1}", "计算，并将结果化为最简分数：", "\\[", "\\frac13 + \\frac15, \\qquad", "\\frac72 - \\frac53, \\qquad", "\\frac{5}{12} + \\frac38, \\qquad", "3 - \\frac45 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g9:fractions:2}", "计算并化简：", "\\[", "\\frac59 \\times \\frac{27}{35}, \\qquad", "\\frac{8}{15} \\div \\frac{4}{5}, \\qquad", "\\frac23 \\times \\frac34 \\times \\frac45 .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g9:fractions:3}", "计算：", "\\[", "2^5, \\qquad (-2)^4, \\qquad -2^4, \\qquad 4^{-2}, \\qquad", "\\left(\\tfrac23\\right)^3, \\qquad 7^0 .", "\\]", "\\end{exercise}", ""]}