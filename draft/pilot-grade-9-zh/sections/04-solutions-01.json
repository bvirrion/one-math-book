{"sha": "34d525ce558f8741d0ebcf701d4d82031f2bcb6a6c84eece08b3550a185bbac1", "body": ["\\section*{第 \\ref{ch:g9:algebra} 章 --- 代数与方程}", "", "\\begin{solution}{exo:g9:algebra:1}", "$4(3x - 2) = 12x - 8$.", "", "$(x+6)(x+2) = x^2 + 2x + 6x + 12 = x^2 + 8x + 12$.", "", "$(2x-3)(x+5) = 2x^2 + 10x - 3x - 15 = 2x^2 + 7x - 15$.", "", "$(x-1)(x-9) = x^2 - 9x - x + 9 = x^2 - 10x + 9$.", "\\end{solution}", "", "\\begin{solution}{exo:g9:algebra:2}", "$(x+8)^2 = x^2 + 16x + 64$.", "", "$(3x-4)^2 = 9x^2 - 24x + 16$.", "", "$(x+10)(x-10) = x^2 - 100$.", "", "$(5x+2)(5x-2) = 25x^2 - 4$.", "\\end{solution}", "", "\\begin{solution}{exo:g9:algebra:3}", "$101^2 = (100+1)^2 = 10000 + 200 + 1 = 10201$.", "", "$59^2 = (60-1)^2 = 3600 - 120 + 1 = 3481$.", "", "$53 \\times 47 = (50+3)(50-3) = 2500 - 9 = 2491$.", "\\end{solution}", "", "\\begin{solution}{exo:g9:algebra:4}", "$9x + 12 = 3(3x + 4)$.", "", "$x^2 - 64 = (x+8)(x-8)$.", "", "$x^2 + 14x + 49 = (x+7)^2$.", "", "$18x^2 - 6x = 6x(3x - 1)$.", "\\end{solution}", "", "\\begin{solution}{exo:g9:algebra:5}", "$4x + 7 = 19$：$4x = 12$，故 $x = 3$。", "", "$6x - 5 = 2x + 11$：$4x = 16$，故 $x = 4$。", "", "$5(x-3) = 3x + 1$：$5x - 15 = 3x + 1$，于是 $2x = 16$ 且 $x = 8$。", "\\end{solution}", "", "\\begin{solution}{exo:g9:algebra:6}", "$(x+4)(3x-12) = 0$：$x = -4$ 或 $x = 4$。", "", "$x^2 - 121 = (x-11)(x+11) = 0$：$x = 11$ 或 $x = -11$。", "", "$(2x-1)^2 = 0$：唯一解为 $x = \\frac12$。", "", "$x^2 = 8x$：$x(x - 8) = 0$，故 $x = 0$ 或 $x = 8$。", "\\end{solution}", "", "\\begin{solution}{exo:g9:algebra:7}", "利用平方差公式，取 $a = 3x + 2$，$b = 5$：", "\\[", "E = (3x + 2)^2 - 5^2 = (3x + 2 + 5)(3x + 2 - 5) = (3x + 7)(3x - 3).", "\\]", "零乘积法则：由 $3x + 7 = 0$ 得 $x = -\\frac73$，又由 $3x - 3 = 0$", "得 $x = 1$。", "\\end{solution}", "", "\\begin{solution}{exo:g9:algebra:8}", "$3x - 4 \\geq 8$：$3x \\geq 12$，故 $x \\geq 4$（$4$ 处为实心点，", "向右涂色）。", "", "$5 - 2x > 1$：$-2x > -4$，两边除以 $-2$ 时不等号反向：$x < 2$", "（$2$ 处为空心点，向左涂色）。", "", "$4(x+1) \\leq x - 5$：$4x + 4 \\leq x - 5$，故 $3x \\leq -9$，", "即 $x \\leq -3$（$-3$ 处为实心点，向左涂色）。", "\\end{solution}", "", "\\begin{solution}{exo:g9:algebra:9}", "设所求数为 $x$：$3x + 7 = 5x - 9$。于是 $16 = 2x$，故 $x = 8$。", "验证：$3 \\times 8 + 7 = 31$，$5 \\times 8 - 9 = 31$。", "\\end{solution}", "", "\\begin{solution}{exo:g9:algebra:10}", "\\emph{1.} $(n+1)(n-1) = n^2 - 1$（第三个乘法公式）。$n$ 的相邻两数", "为 $n - 1$ 与 $n + 1$，故其积为 $n^2 - 1$：例如\\", "$24 \\times 26 = 625 - 1 = 624$。", "", "\\emph{2.} 三个连续整数可记为 $n - 1$，$n$，", "$n + 1$。它们的和为", "\\[", "(n-1) + n + (n+1) = 3n ,", "\\]", "是 $3$ 的倍数（即中间那个数的三倍）。", "\\end{solution}", "", "\\begin{solution}{pb:g9:algebra:1}", "\\textbf{1.} $(10a + b) - (10b + a) = 9a - 9b = 9(a - b)$：两位数与其数字对调后的数之差", "总是 $9$ 的倍数。", "验证：$72 - 27 = 45 = 9 \\times 5$，且", "$a - b = 7 - 2 = 5$。", "", "\\textbf{2.} 展开右边：", "$9(11a + b) + a + b + c = 99a + 9b + a + b + c", "= 100a + 10b + c$。因此该数等于 $9$ 的倍数加上", "其数字和：两者除以 $9$ 所得余数相同。", "特别地，一者余数为 $0$，意味着另一者", "余数亦为 $0$。这就是弃九法，已证。", "", "\\textbf{3.} $9(11a + b)$ 也是 $3$ 的倍数，因此同一恒等式", "说明该数与其数字和除以 $3$ 所得余数相同，", "这即弃三法。", ""]}