{"sha": "ce75e62c676da5c57434734c4471a2a8a5233d7a1a7987f24b4b6af0b7de5e47", "body": ["\\section{应用}", "", "\\begin{definition}[平均值]\\label{def:g12:integ:mean}", "称连续函数 $f$ 在", "$\\intcc{a}{b}$（$a<b$）上的\\emph{平均值}\\index{平均值}为", "\\[", "\\mu = \\frac{1}{b-a}\\int_a^b f(t)\\,\\dd t .", "\\]", "\\end{definition}", "", "\\begin{proposition}\\label{prop:g12:integ:meanbounds}", "若 $m \\leq f \\leq M$ 在 $\\intcc{a}{b}$ 上成立，则 $m \\leq \\mu \\leq M$。", "\\end{proposition}", "", "\\begin{proof}", "对不等式 $m \\leq f(t) \\leq M$ 在 $\\intcc{a}{b}$ 上积分，", "再除以 $b - a > 0$。", "\\end{proof}", "", "\\begin{method}[两条曲线之间的面积]\\label{met:g12:integ:areabetween}", "若 $f \\geq g$ 在 $\\intcc{a}{b}$ 上，则两曲线之间的面积为", "$\\int_a^b \\bigl(f(x) - g(x)\\bigr)\\dd x$。若两曲线相交，则在交点处将", "区间分段，并对 $\\abs{f - g}$ 逐段积分。", "\\end{method}", "", "\\begin{omfigure}", "\\begin{tikzpicture}", "\\begin{axis}[omaxis,", "  width=8.4cm, height=5.8cm,", "  xmin=-2.1, xmax=2.9, ymin=-1.8, ymax=5.6,", "  xtick={-1,2}, ytick=\\empty]", "  \\addplot[name path=line, omThm, thick, domain=-1.7:2.5] {x + 1};", "  \\addplot[name path=parab, omDef, thick, domain=-1.9:2.45] {x^2 - 1};", "  \\addplot[omDef!20] fill between[of=line and parab,", "    soft clip={domain=-1:2}];", "  \\fill (axis cs:-1,0) circle (1.5pt);", "  \\fill (axis cs:2,3) circle (1.5pt);", "\\end{axis}", "\\end{tikzpicture}", "", "{\\small 直线 $y = x + 1$（红色）与抛物线", "$y = x^2 - 1$（蓝色）之间的面积为 $\\int_{-1}^{2}", "\\bigl((x+1) - (x^2-1)\\bigr)\\dd x = \\frac92$。}", "\\end{omfigure}", "", "\\section{练习}", "", "\\begin{exercise}[$\\star$]\\label{exo:g12:integ:1}", "计算", "\\[", "\\int_1^2 \\left(3x^2 - \\frac{1}{x^2}\\right)\\dd x, \\qquad", "\\int_0^{\\pi/2} \\cos t \\,\\dd t, \\qquad", "\\int_0^{1} \\frac{\\dd t}{2t+1} .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g12:integ:2}", "求 $F$，使其为 $f(x) = x\\eu^{x^2}$ 在 $\\R$ 上的原函数，且 $F(0) = 1$。", "\\end{exercise}", "", "\\begin{exercise}[$\\star$]\\label{exo:g12:integ:3}", "求 $f(t) = \\sin t$ 在 $\\intcc{0}{\\pi}$ 上的平均值，并", "借助图像解释所得结果。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g12:integ:4}", "利用分部积分法计算", "\\[", "\\int_1^{\\eu} \\ln t\\,\\dd t", "\\qquad\\text{ 和 }\\qquad", "\\int_0^{\\pi} t \\sin t\\,\\dd t .", "\\]", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g12:integ:5}", "求抛物线 $y = x^2$ 与直线", "$y = x + 2$ 所围区域的面积。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g12:integ:6}", "设 $I = \\displaystyle\\int_0^1 \\frac{\\dd t}{1 + t}$。", "\\begin{enumerate}", "  \\item 计算 $I$。", "  \\item 对 $n \\in \\N$，记 $I_n = \\displaystyle\\int_0^1 \\frac{t^n}{1+t}\\dd t$。", "        证明 $I_n + I_{n+1} = \\dfrac{1}{n+1}$，并证明", "        $0 \\leq I_n \\leq \\dfrac{1}{n+1}$。", "  \\item 由此推出", "        $1 - \\frac12 + \\frac13 - \\dots + \\frac{(-1)^{n-1}}{n}", "        \\xrightarrow[n \\to +\\infty]{} \\ln 2$。", "\\end{enumerate}", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star$]\\label{exo:g12:integ:7}", "火车出发后前 $100$ 秒内的速度（单位：m/s）", "可由 $v(t) = 30\\bigl(1 - \\eu^{-t/50}\\bigr)$ 描述。求", "这 $100$ 秒内行驶的距离，以及火车在该", "时间区间上的平均速度。", "\\end{exercise}", "", "\\begin{exercise}[$\\star\\star\\star$]\\label{exo:g12:integ:8}", "对 $n \\geq 1$，记 $S_n = \\dfrac1n \\displaystyle\\sum_{k=1}^{n} \\frac{1}{1 + k/n}$。", "\\begin{enumerate}", "  \\item 将 $S_n$ 解释为近似某区域面积的矩形面积，该区域为", "        $t \\mapsto \\frac{1}{1+t}$ 的曲线在 $\\intcc{0}{1}$ 上的下方区域。", "  \\item 利用 $t \\mapsto \\frac{1}{1+t}$ 的单调性，证明", "        \\[", "        S_n \\leq \\int_0^1 \\frac{\\dd t}{1+t} \\leq S_n + \\frac1n\\left(1 - \\frac12\\right),", "        \\]，", "        并由此推出 $\\lim\\limits_{n\\to+\\infty} S_n = \\ln 2$。", "\\end{enumerate}", "\\end{exercise}", ""]}