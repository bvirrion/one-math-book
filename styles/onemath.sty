% ============================================================================
% onemath.sty — shared style for the One Math Book project
%
% All packages, theorem environments and macros live here. Chapter files must
% not load packages or define macros: if you need something new, add it here
% and document it in CONTRIBUTING.md.
%
% Language: set \booklang before loading (default en). UI strings and part
% titles live in styles/lang/<lang>.tex. Chapter bodies for non-English
% languages live under parts/<year>/<lang>/ (see \ominput / \ominputsol).
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{onemath}[2026/07/11 v0.2 One Math Book common style]

% ----------------------------------------------------------------------------
% Language selection (default: English)
% ----------------------------------------------------------------------------
\providecommand{\booklang}{en}

% ----------------------------------------------------------------------------
% Core packages
% ----------------------------------------------------------------------------
% Engine / script detection. Hindi editions use Devanagari and must be built
% with XeLaTeX (or LuaLaTeX); pdfTeX cannot load OpenType Devanagari fonts.
% Other languages stay on the historical pdfTeX path (T1 + lmodern).
\RequirePackage{iftex}
\edef\om@booklang@exp{\booklang}%
\def\om@lang@fr{fr}%
\def\om@lang@nl{nl}%
\def\om@lang@es{es}%
\def\om@lang@pt{pt}%
\def\om@lang@hi{hi}%
\def\om@lang@ar{ar}%
\newif\ifom@hindi
\newif\ifom@arabic
\ifx\om@booklang@exp\om@lang@hi
  \om@hinditrue
\fi
\ifx\om@booklang@exp\om@lang@ar
  \om@arabictrue
\fi

\ifom@hindi
  \ifPDFTeX
    \PackageError{onemath}{%
      Hindi editions require XeLaTeX (or LuaLaTeX).\MessageBreak
      Use: xelatex \jobname.tex\MessageBreak
      (or latexmk, which picks XeLaTeX for *_hi.tex)}{Build with XeLaTeX.}%
  \fi
  \RequirePackage{fontspec}%
  % Bundled under assets/fonts/ so CI and local builds do not depend on
  % system font packages. Noto Sans Devanagari covers Devanagari + basic Latin.
  %
  % Noto Sans Devanagari ships Regular and Bold only: no italic, no small
  % caps. Left undeclared, every \emph and \textsc in the book raised
  % "Font shape TU/NotoSansDevanagari(0)/m/it undefined" and silently fell
  % back to upright — so every defined term, which the sources mark as
  % \emph{term}\index{term} inside a definition, was typographically
  % invisible in the Hindi PDFs. Alias the missing shapes onto the faces we
  % have (the warnings go away and nothing changes shape), then carry
  % emphasis with WEIGHT instead, which is what Devanagari typography does:
  % the script has no italic tradition.
  \IfFileExists{assets/fonts/NotoSansDevanagari-Regular.ttf}{%
    \setmainfont{NotoSansDevanagari}[%
      Path=assets/fonts/,%
      Extension=.ttf,%
      UprightFont=*-Regular,%
      BoldFont=*-Bold,%
      ItalicFont=*-Regular,%
      BoldItalicFont=*-Bold,%
      SmallCapsFont=*-Regular,%
      Script=Devanagari,%
    ]%
  }{%
    \setmainfont{Noto Sans Devanagari}[Script=Devanagari]%
  }%
  % \emph -> bold at the first level, upright at the second (nested emphasis
  % toggles back, as \em does in Latin scripts). \DeclareEmphSequence is the
  % supported hook for this; do not \renewcommand\emph, which breaks nesting.
  \DeclareEmphSequence{\bfseries,\normalfont}%
\else
  \ifom@arabic
    % Arabic is the first right-to-left edition. It needs LuaTeX, not XeTeX:
    % the bidirectional engine we use is babel's own "bidi=basic", which is
    % implemented in Lua and therefore does not patch LaTeX internals the way
    % the xetex "bidi" package does. That matters here because this stack
    % leans on tcolorbox[most], tikz, pgfplots and hyperref, all of which
    % "bidi" is known to fight with. See the babel block below for the four
    % fixes the combination still needs.
    \ifLuaTeX\else
      \PackageError{onemath}{%
        Arabic editions require LuaLaTeX.\MessageBreak
        Use: lualatex \jobname.tex\MessageBreak
        (or latexmk, which picks LuaLaTeX for *_ar.tex)}{Build with LuaLaTeX.}%
    \fi
    \RequirePackage{fontspec}%
  \else
    \ifPDFTeX
      \RequirePackage[T1]{fontenc}%
      \RequirePackage[utf8]{inputenc}%
      \RequirePackage{lmodern}%
    \fi
  \fi
\fi
\RequirePackage{microtype}
% microtype letterspacing (\textls) is not implemented for XeTeX; Hindi
% editions use XeLaTeX for Devanagari. Provide a no-op so the cover wordmark
% and branded header still compile (tracking is cosmetic).
\ifXeTeX
  \DeclareRobustCommand{\textls}[2][]{#2}%
\fi
\RequirePackage[a4paper,inner=2.2cm,outer=2.2cm,top=2.4cm,bottom=2.6cm,headheight=14pt]{geometry}

% babel: only for non-English editions (keeps English builds unchanged).
% Compare expanded token lists so \newcommand{\booklang}{fr} matches.
% Load language babel only when the .ldf is installed; UI strings still
% come from styles/lang/<lang>.tex either way.
% shorthands=off: French (and Dutch/Spanish/Portuguese) babel makes characters
% such as ":" active for punctuation spacing. Our labels use colons throughout
% (type:year:slug:name) and cleveref cannot parse active characters in
% label names — CI with full TeX Live would fail at the first \cref.
% French/Dutch sources already use ~ before :;!? for spacing.
\ifx\om@booklang@exp\om@lang@fr
  \IfFileExists{french.ldf}{%
    \RequirePackage[french,shorthands=off]{babel}%
  }{%
    \PackageWarning{onemath}{%
      french.ldf not found; building French without babel.
      Install texlive-lang-french for hyphenation}%
  }%
\fi
\ifx\om@booklang@exp\om@lang@nl
  \IfFileExists{dutch.ldf}{%
    \RequirePackage[dutch,shorthands=off]{babel}%
  }{%
    \PackageWarning{onemath}{%
      dutch.ldf not found; building Dutch without babel.
      Install texlive-lang-european (or babel-dutch) for hyphenation}%
  }%
\fi
\ifx\om@booklang@exp\om@lang@es
  \IfFileExists{spanish.ldf}{%
    \RequirePackage[spanish,es-noshorthands,shorthands=off]{babel}%
    % babel-spanish redefines \% to auto-insert a thin space; its
    % \lastskip probe is fatal after a math \, (mu-glue), and the
    % sources set the space explicitly ($t\,\%$, as in fr/nl).
    \spanishplainpercent
  }{%
    \PackageWarning{onemath}{%
      spanish.ldf not found; building Spanish without babel.
      Install texlive-lang-spanish for hyphenation}%
  }%
\fi
\ifx\om@booklang@exp\om@lang@pt
  % Brazilian Portuguese (babel: brazilian). Fall back to portuguese.ldf
  % if only the European pack is installed.
  \IfFileExists{brazilian.ldf}{%
    \RequirePackage[brazilian,shorthands=off]{babel}%
  }{%
    \IfFileExists{portuguese.ldf}{%
      \RequirePackage[portuguese,shorthands=off]{babel}%
    }{%
      \IfFileExists{portuges.ldf}{%
        \RequirePackage[portuges,shorthands=off]{babel}%
      }{%
        \PackageWarning{onemath}{%
          brazilian/portuguese.ldf not found; building Portuguese without babel.
          Install texlive-lang-portuguese for hyphenation}%
      }%
    }%
  }%
\fi
% Hindi: no babel.ldf is required. Modern babel-hindi needs a full TeX Live
% Indic install and conflicts with our colon-bearing labels if shorthands are
% left on. UI strings come from styles/lang/hi.tex; hyphenation is optional.
\ifom@hindi
  \PackageInfo{onemath}{Hindi edition: fontspec + styles/lang/hi.tex (no babel)}%
  % Table of contents: book.cls sizes the page-number box at \@pnumwidth =
  % 1.55em, which fits three Latin Modern digits. Noto Sans Devanagari's
  % digits are wider, so every three-digit entry overflowed by exactly
  % 1.12782pt -- that single cause accounted for ALL of the overfull boxes
  % in the Hindi editions (195/102/79/74/81 in books 1-5), while every other
  % language sat at zero. Not a prose problem: the logs show no "Overfull
  % \hbox ... in paragraph" at all, so Hindi needs no hyphenation patterns
  % here. Widen the box and push the entry's right margin out by the same
  % amount so the leader dots still stop clear of the number.
  \renewcommand{\@pnumwidth}{2.2em}%
  \renewcommand{\@tocrmarg}{3.2em}%
\fi

% ----------------------------------------------------------------------------
% Arabic: right-to-left, via babel's Lua bidi engine.
%
% "layout=graphics" is load-bearing, not cosmetic. Without it every pgfpicture
% -- which includes the frame of every tcolorbox, i.e. every statement
% environment in the series -- is drawn mirrored about the picture origin, so
% the coloured box lands beside its own text, off the page. babel's own patch
% (luababel.def, \bbl@pictsetdir) typesets pictures left-to-right and then
% re-applies RTL at each tikz node, which is exactly what figures need: the
% drawing coordinates stay untouched and only the node text reads RTL.
%
% Four more fixes live after the packages load; see "Arabic runtime fixes"
% below.
% ----------------------------------------------------------------------------
\ifom@arabic
  % layout=tabular is the second load-bearing one. babel's bidi=basic
  % implements the Unicode algorithm's W1-W7 and N1-N2 but NOT N0, the paired
  % bracket rule, so a table cell like "$V$ (\unit{mL})" ended with its
  % closing parenthesis taking the paragraph direction: the cell rendered
  % "(mLV (", with two opening brackets and none closing. \babelsublr around
  % the cell does not help -- the direction is decided for the cell box.
  % layout=tabular fixes the cells and, correctly for a right-to-left book,
  % orders the columns right to left. Prose is unaffected: a parenthesised
  % Latin run inside an Arabic sentence already resolved correctly, because
  % there the closing bracket has following context to key on.
  \RequirePackage[bidi=basic,layout=graphics.tabular]{babel}%
  % Table of contents. Arabic prose uses ASCII digits, so this looked like it
  % would not be needed -- but it is: Noto Naskh Arabic's ASCII digits are
  % themselves wider than Latin Modern's, and every three-digit contents entry
  % overflowed \@pnumwidth by 1.39063pt. That single cause produced 147 of the
  % 149 overfull boxes in the first Arabic build, against 0 for English; the
  % log said "detected at line", i.e. a box, not "in paragraph", so this is not
  % a hyphenation problem and Arabic needs no patterns here either.
  \renewcommand{\@pnumwidth}{2.2em}%
  \renewcommand{\@tocrmarg}{3.2em}%
  \babelprovide[import,main]{arabic}%
  % One bundled variable font for every shape. Noto Naskh Arabic is a book
  % face: it carries the full Arabic block AND full ASCII, which matters
  % because the prose is full of parentheses, ASCII digits and Latin symbols.
  % (The *static* Noto Naskh has no ASCII at all -- not even "(" -- so do not
  % "simplify" this back to Regular/Bold .ttf files.)
  %
  % Every shape is aliased onto the one file, with the weight taken from the
  % variable font's wght axis. Arabic has no italic and no small caps; left
  % undeclared, the bold shape comes out undefined and every
  % \emph{term}\index{term} -- the series' marker for a defined term -- is
  % typographically invisible, exactly as it was in Hindi before its fix.
  \IfFileExists{assets/fonts/NotoNaskhArabic-VF.ttf}{%
    \babelfont{rm}[%
      Path=assets/fonts/,%
      Extension=.ttf,%
      UprightFont=*, BoldFont=*, ItalicFont=*,%
      BoldItalicFont=*, SmallCapsFont=*,%
      UprightFeatures={RawFeature={axis={wght=400}}},%
      BoldFeatures={RawFeature={axis={wght=700}}},%
      ItalicFeatures={RawFeature={axis={wght=400}}},%
      BoldItalicFeatures={RawFeature={axis={wght=700}}},%
      SmallCapsFeatures={RawFeature={axis={wght=400}}},%
      Script=Arabic,%
    ]{NotoNaskhArabic-VF}%
  }{%
    \babelfont{rm}[Script=Arabic]{Noto Naskh Arabic}%
  }%
  % Emphasis by weight, as in the Hindi edition: the script has no italic
  % tradition. \DeclareEmphSequence is the supported hook; do not
  % \renewcommand\emph, which breaks nesting.
  \DeclareEmphSequence{\bfseries,\normalfont}%
\fi

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathtools}
\RequirePackage{enumitem}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween}
\usetikzlibrary{arrows.meta,calc,angles,quotes,patterns}
% Unbreakable in-text figure block: keeps a picture and its caption line
% on the same page. Use in place of "center" around tikzpicture figures.
\newenvironment{omfigure}
  {\par\medskip\noindent\begin{minipage}{\linewidth}\centering}
  {\end{minipage}\par\medskip}

% Shared axis style for in-text figures: use with \begin{axis}[omaxis, ...].
\pgfplotsset{
  omaxis/.style={
    axis lines=middle,
    tick label style={font=\small},
    label style={font=\small},
    xlabel={$x$}, ylabel={$y$},
    xlabel style={below right}, ylabel style={above left},
    samples=100,
  },
}
\RequirePackage[most]{tcolorbox}
\RequirePackage{imakeidx}
\makeindex[intoc]
\RequirePackage[colorlinks=true,linkcolor=blue!50!black,urlcolor=blue!50!black]{hyperref}
\RequirePackage[nameinlink,capitalize]{cleveref}
\RequirePackage{etoolbox}

% ----------------------------------------------------------------------------
% Arabic runtime fixes. These must come AFTER mathtools, tikz, pgfplots and
% tcolorbox are loaded, because each one repairs an interaction with them.
% All four were found by building the real chapters, not by reading docs; a
% green log does not reveal any of them, only the rendered page does.
% ----------------------------------------------------------------------------
\ifom@arabic
  % 1. babel vs mathtools. luababel.def does \bbl@sreplace\intertext@{...}
  %    when an RTL language is provided. mathtools has already redefined
  %    \intertext@ in expl3 syntax, and \bbl@sreplace re-tokenises that body
  %    WITHOUT expl3 catcodes, so \l_MT_below_intertext_sep comes back as \l
  %    followed by garbage. Every single align/gather in the book then fails
  %    with "Undefined control sequence". Save mathtools' meaning here and put
  %    it back after babel's own \AtBeginDocument patch has run (ours is
  %    declared later, so it runs later). \intertext is used nowhere in the
  %    sources, so losing babel's baseline tweak for it costs nothing.
  \let\om@saved@intertext\intertext@
  \AtBeginDocument{\let\intertext@\om@saved@intertext}%
  % 2. Whole pictures are typeset left-to-right. layout=graphics already does
  %    this for pgfpicture, but pgfplots places its axis label and tick label
  %    rows outside the tikz-node path that babel re-orients, so an axis came
  %    out with its x labels mirrored and shifted a full picture-width left.
  %    Use babel's OWN \bbl@textdir, not the raw \textdir primitive: the
  %    primitive changes TeX's direction but not the attribute babel's Lua
  %    filter reads, so the filter still walked the picture as RTL and died
  %    with "babel-bidi-basic.lua:345: attempt to index a nil value" on the
  %    first pgfplots mark glyph. Forcing it properly fixes the whole
  %    family; babel still restores RTL inside each tikz node, so Arabic node
  %    text reads correctly.
  \AddToHook{env/tikzpicture/before}{\leavevmode\begingroup\bbl@textdir\z@}%
  \AddToHook{env/tikzpicture/after}{\endgroup}%
  % 3. ... but tcolorbox builds its content INSIDE that left-to-right picture
  %    scope, so without this the Arabic inside every definition, theorem and
  %    exercise box came out in reversed word order. Put the box body back to
  %    RTL.
  \tcbset{before upper={\pardir TRT\textdir TRT}}%
  % 4. pgfplots axis labels and titles are Arabic prose and must read RTL
  %    inside the otherwise left-to-right picture.
  \pgfplotsset{every axis/.append style={%
    label style={execute at begin node={\pardir TRT\textdir TRT}},%
    title style={execute at begin node={\pardir TRT\textdir TRT}},%
  }}%
\fi

